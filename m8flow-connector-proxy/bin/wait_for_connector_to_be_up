#!/usr/bin/env bash
# Block until the connector proxy answers its liveness probe, or give up after a
# bounded number of one-second polls.
set -euo pipefail

max_attempts="${1:-100}"
port="${2:-7004}"
liveness_url="http://localhost:${port}/v1/liveness"

echo "Waiting for the connector proxy on port ${port} ..."
for _ in $(seq 1 "$max_attempts"); do
  status="$(curl -s -o /dev/null -w '%{http_code}' "$liveness_url" || true)"
  if [[ "$status" == "200" ]]; then
    echo "Connector proxy is up."
    exit 0
  fi
  sleep 1
done

>&2 echo "ERROR: connector proxy did not become healthy within ${max_attempts} attempts."
exit 1
