#!/usr/bin/env bash
# Starts the connector proxy inside the container image.
# Local developer startup stays on bin/run_server_locally.

set -euo pipefail

read_setting() {
  local name="$1"
  local fallback="$2"
  local value="${!name:-}"
  if [[ -n "${value}" ]]; then
    printf '%s' "${value}"
    return
  fi
  printf '%s' "${fallback}"
}

main() {
  local bind_host="0.0.0.0"
  local port
  local worker_count
  local timeout_seconds
  local log_level
  local request_line_limit

  port="$(read_setting CONNECTOR_PROXY_PORT 7004)"
  worker_count="$(read_setting CONNECTOR_PROXY_GUNICORN_WORKERS 3)"
  timeout_seconds="$(read_setting CONNECTOR_PROXY_GUNICORN_TIMEOUT_SECONDS 90)"
  log_level="$(read_setting CONNECTOR_PROXY_GUNICORN_LOG_LEVEL debug)"
  request_line_limit="$(read_setting CONNECTOR_PROXY_GUNICORN_LIMIT_REQUEST_LINE 8192)"

  # Some connector OAuth callbacks exceed gunicorn's default request-line limit.
  export GUNICORN_CMD_ARGS="--bind ${bind_host}:${port} --workers ${worker_count} --timeout ${timeout_seconds} --limit-request-line ${request_line_limit} --capture-output --access-logfile - --log-level ${log_level}"

  printf 'connector-proxy boot: gunicorn listening on %s:%s with %s workers\n' \
    "${bind_host}" \
    "${port}" \
    "${worker_count}"

  exec poetry run gunicorn app:app
}

main "$@"
