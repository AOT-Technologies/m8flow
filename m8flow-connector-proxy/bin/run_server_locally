#!/usr/bin/env bash
# m8flow-connector-proxy/bin/run_server_locally
# Local dev entrypoint: runs the connector proxy under Flask's own dev server
# (debug/reload) rather than gunicorn. The container/prod boot path is
# bin/boot_server_in_docker instead.

function error_handler() {
  >&2 echo "Exited with BAD EXIT CODE '${2}' in ${0} script at line: ${1}."
  exit "$2"
}
trap 'error_handler ${LINENO} $?' ERR
set -o errtrace -o errexit -o nounset -o pipefail

export FLASK_DEBUG="${FLASK_DEBUG:-1}"
export FLASK_SESSION_SECRET_KEY=super_secret_key  # dev-only fixed secret; prod boot never sources this script

poetry run flask run --host=0.0.0.0 --port="${CONNECTOR_PROXY_PORT:-7004}"
