# m8flow MCP Server Configuration

# ============================================================================
# Server Configuration
# ============================================================================
SERVER_TYPE=stdio  # Options: stdio (Claude Desktop) or remote (HTTP/Cursor)
HOST=0.0.0.0
PORT=8000

# ============================================================================
# m8flow Backend API
# ============================================================================
M8FLOW_API_URL=http://localhost:6840
M8FLOW_API_TIMEOUT=30

# ============================================================================
# Keycloak Authentication
# ============================================================================
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=m8flow
CLIENT_ID=m8flow-mcp
CLIENT_SECRET=  # Optional - only for confidential clients

# ============================================================================
# Authentication Methods (choose one)
# ============================================================================

# Method 1: Manual Bearer Token (simplest for testing)
# Get a token from m8flow UI or Keycloak directly
# M8FLOW_BEARER_TOKEN=eyJhbGciOiJSUzI1NiIsInR5cCI...

# Method 2: ROPC (Resource Owner Password Credentials) - RECOMMENDED
# Automatically fetches and refreshes tokens using username/password
KEYCLOAK_USERNAME=your-username
KEYCLOAK_PASSWORD=your-password

# Note: ROPC requires a Keycloak client with "Direct Access Grants" enabled

# ============================================================================
# JWT Verification (for remote mode)
# ============================================================================
# Path to Keycloak public key for JWT verification
# AUTHZ_SERVER_PUBLIC_KEY_PATH=/path/to/public_key.pem

# ============================================================================
# OIDC Configuration (for remote/HTTP mode)
# ============================================================================
OIDC_CONFIG_URL=${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}/.well-known/openid-configuration
REQUIRED_SCOPES=openid,profile,email
VERIFY_ID_TOKEN=true

# ============================================================================
# Multi-Tenancy
# ============================================================================
# Default tenant ID (optional - usually extracted from JWT)
# DEFAULT_TENANT_ID=tenant-1

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # Options: json, text

# ============================================================================
# Rate Limiting (Future)
# ============================================================================
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=60

# ============================================================================
# Development
# ============================================================================
DEBUG=false
RELOAD=false  # Auto-reload on code changes
