# ============================================================================
# m8flow MCP Server
#
# Copy this file to `.env` and update the values for your environment.
#
# Authentication priority:
#   1. Browser login (OIDCProxy) - Remote/HTTP mode
#   2. Static bearer token
#   3. Username/password (ROPC)
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------

SERVER_TYPE=stdio          # stdio (Claude Desktop) | remote (Cursor/HTTP)
HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------------------------------
# m8flow Backend
# ----------------------------------------------------------------------------

M8FLOW_API_URL=http://localhost:6840
M8FLOW_API_TIMEOUT=30

# ----------------------------------------------------------------------------
# Keycloak Configuration
# ----------------------------------------------------------------------------

KEYCLOAK_URL=http://localhost:6842
KEYCLOAK_REALM=m8flow

# Keycloak client used by the MCP server.
#
# Browser login needs CLIENT_ID + CLIENT_SECRET + MCP_OIDC_BASE_URL all non-empty
# (Settings.has_oidc_client); with any blank, no auth provider is built. Use its own
# confidential client, not m8flow-backend -- that one's redirect URIs point at the
# backend/frontend. Redirect URI: <MCP_OIDC_BASE_URL>/oauth/callback.
CLIENT_ID=m8flow-mcp

# Required for browser (OIDC) authentication. Empty = browser login disabled.
CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------

# Method 1 - Static Bearer Token
# M8FLOW_BEARER_TOKEN=eyJhbGciOiJSUzI1NiIs...

# Method 2 - Username / Password (ROPC)
# Requires Direct Access Grants enabled on the client.
# KEYCLOAK_USERNAME=
# KEYCLOAK_PASSWORD=

# Method 3 - Browser Login (Remote Mode)
OIDC_CONFIG_URL=${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}/.well-known/openid-configuration

REQUIRED_SCOPES=openid,profile,email
VERIFY_ID_TOKEN=true

# Public base URL of this MCP server -- root origin, NO path.
# A "/mcp" suffix 404s every advertised OAuth endpoint (it would advertise
# /mcp/authorize); those routes live at the app root.
#
# Example:
# MCP_OIDC_BASE_URL=http://localhost:8000
# MCP_OIDC_ISSUER_URL=http://localhost:8000

MCP_OIDC_BASE_URL=
MCP_OIDC_ISSUER_URL=

MCP_OIDC_REDIRECT_PATH=/oauth/callback

# ----------------------------------------------------------------------------
# Inbound token acceptance (transport authentication)
# ----------------------------------------------------------------------------

# Verify inbound tokens against the realm(s) below. Off by default; turning it on makes
# this server reject any request without a valid realm token (a static-bearer / ROPC
# setup sends none). Turn it on together with browser login: an OAuth proxy rejects the
# caller's own realm token that the backend "MCP Tools" page forwards, so the page needs
# this to work alongside browser login.
# ACCEPT_REALM_TOKENS=true

# Realms whose tokens are accepted. Empty = KEYCLOAK_REALM only. Set both when tenant
# users sign in via the shared realm and super-admins via master -- the realms have
# disjoint signing keys, so a master token fails an m8flow-only verifier.
ACCEPTED_TOKEN_REALMS=m8flow master

