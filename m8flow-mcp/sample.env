# ============================================================================
# m8flow MCP Server
#
# Copy this file to `.env` and update the values for your environment.
#
# Authentication priority:
#   1. Browser login (OIDCProxy) - Remote/HTTP mode
#   2. Static bearer token
#   3. Username/password (ROPC)
# ============================================================================

# ----------------------------------------------------------------------------
# Server Configuration
# ----------------------------------------------------------------------------

SERVER_TYPE=stdio          # stdio (Claude Desktop) | remote (Cursor/HTTP)
HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------------------------------
# m8flow Backend
# ----------------------------------------------------------------------------

M8FLOW_API_URL=http://localhost:6840
M8FLOW_API_TIMEOUT=30

# ----------------------------------------------------------------------------
# Keycloak Configuration
# ----------------------------------------------------------------------------

KEYCLOAK_URL=http://localhost:6842
KEYCLOAK_REALM=m8flow

# Keycloak client used by the MCP server
CLIENT_ID=m8flow-backend

# Required for browser (OIDC) authentication
CLIENT_SECRET=

# ----------------------------------------------------------------------------
# Authentication
# ----------------------------------------------------------------------------

# Method 1 - Static Bearer Token
# M8FLOW_BEARER_TOKEN=eyJhbGciOiJSUzI1NiIs...

# Method 2 - Username / Password (ROPC)
# Requires Direct Access Grants enabled on the client.
# KEYCLOAK_USERNAME=
# KEYCLOAK_PASSWORD=

# Method 3 - Browser Login (Remote Mode)
OIDC_CONFIG_URL=${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}/.well-known/openid-configuration

REQUIRED_SCOPES=openid,profile,email
VERIFY_ID_TOKEN=true

# Public URL of this MCP server.
# Required only in remote mode.
# Example:
# MCP_OIDC_BASE_URL=http://localhost:8000
# MCP_OIDC_ISSUER_URL=http://localhost:8000

MCP_OIDC_BASE_URL=
MCP_OIDC_ISSUER_URL=

MCP_OIDC_REDIRECT_PATH=/oauth/callback

# Require the OAuth consent screen during browser login. Leave false for silent SSO.
MCP_OIDC_REQUIRE_CONSENT=false

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------

LOG_LEVEL=INFO            # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json           # json | text