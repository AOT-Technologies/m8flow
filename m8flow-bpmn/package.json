    "dmn-js": "17.5.0",
    "dmn-js-properties-panel": "3.9.0",
    "esbuild": "^0.25.0",
    "inherits-browser": "^0.1.0",
    "tiny-svg": "3.1.3"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "vite": { "optional": true }
  },
  "devDependencies": {
