#!/usr/bin/env bash
# Source (do not execute) this to populate the env vars the m8flow backend reads
# for a local dev run:  `source bin/local_development_environment_setup [keycloak] [acceptance] [process_model_dir]`.
# The SPIFFWORKFLOW_BACKEND_* names are the backend's config contract (kept as-is);
# everything below is m8flow's own layout.

if [ "${BASH_SOURCE[0]}" -ef "$0" ]; then
  echo >&2 "This script sets env vars in your shell — source it, don't run it."
  exit 1
fi

set -o errexit -o errtrace -o nounset -o pipefail
trap 'echo >&2 "failed (exit $?) at line $LINENO of ${BASH_SOURCE[0]}"' ERR

_port="${SPIFFWORKFLOW_BACKEND_PORT:-6840}"
_use_builtin_openid="true"
_acceptance="false"

# Positional flags, in any order: `keycloak` switches auth off the built-in provider,
# `acceptance` loads fixture data, and a directory is taken as the process-model root.
for _arg in "$@"; do
  case "$_arg" in
    keycloak)   _use_builtin_openid="false" ;;
    acceptance) _acceptance="true" ;;
    *) [[ -d "$_arg" ]] && _model_dir="$_arg" ;;
  esac
done

: "${_model_dir:=}"
if [[ -z "${SPIFFWORKFLOW_BACKEND_BPMN_SPEC_ABSOLUTE_DIR:-}" ]]; then
  if [[ -n "$_model_dir" ]]; then
    export SPIFFWORKFLOW_BACKEND_BPMN_SPEC_ABSOLUTE_DIR="$_model_dir"
  else
    export SPIFFWORKFLOW_BACKEND_BPMN_SPEC_ABSOLUTE_DIR="$(./bin/find_sample_process_models)"
  fi
fi

if [[ "$_acceptance" == "true" ]]; then
  export SPIFFWORKFLOW_BACKEND_LOAD_FIXTURE_DATA=true
  export SPIFFWORKFLOW_BACKEND_PERMISSIONS_FILE_NAME=acceptance_tests.yml
fi

if [[ "$_use_builtin_openid" == "true" ]]; then
  _base_url="${SPIFFWORKFLOW_BACKEND_URL:-http://localhost:$_port}"
  export SPIFFWORKFLOW_BACKEND_AUTH_CONFIGS__0__identifier="default"
  export SPIFFWORKFLOW_BACKEND_AUTH_CONFIGS__0__label="internal openid"
  export SPIFFWORKFLOW_BACKEND_AUTH_CONFIGS__0__uri="${_base_url}/openid"
  export SPIFFWORKFLOW_BACKEND_AUTH_CONFIGS__0__additional_valid_issuers__0="http://host.docker.internal:6840/openid"
  export SPIFFWORKFLOW_BACKEND_AUTH_CONFIGS__0__client_id="m8flow-backend"
  export SPIFFWORKFLOW_BACKEND_AUTH_CONFIGS__0__client_secret="f041b49ae7f1a35daa10917459814bcd"
fi

export SPIFFWORKFLOW_BACKEND_ENV="${SPIFFWORKFLOW_BACKEND_ENV:-local_development}"
export SPIFFWORKFLOW_BACKEND_RUN_BACKGROUND_SCHEDULER_IN_CREATE_APP="${SPIFFWORKFLOW_BACKEND_RUN_BACKGROUND_SCHEDULER_IN_CREATE_APP:-true}"
export SPIFFWORKFLOW_BACKEND_FAIL_ON_INVALID_PROCESS_MODELS="${SPIFFWORKFLOW_BACKEND_FAIL_ON_INVALID_PROCESS_MODELS:-false}"
export FLASK_SESSION_SECRET_KEY="e7711a3ba96c46c68e084a86952de16f"
export FLASK_DEBUG=1
