#!/usr/bin/env python
"""Fetch an OpenID access token for local m8flow API poking.

Usage: bin/get_token [username] [password] [realm]

Resolves the token endpoint from (in order): OPENID_TOKEN_URL, KEYCLOAK_BASE_URL
(+ realm), or the backend's built-in /openid provider. Prints the access token to
stdout (other fields go to stderr) so it can be captured in a shell variable:

    TOKEN=$(bin/get_token editor editor)
"""
import base64
import json
import os
import sys
import urllib.parse

import requests

# ruff: noqa: T201  (this is a CLI helper; printing is the whole point)

_LOCAL_DEV_GRANT_SUFFIX = ":this_is_not_secure_do_not_use_in_production"  # noqa: S105
_TOKEN_PATH = "/protocol/openid-connect/token"  # noqa: S105
_DEFAULT_BACKEND = "http://localhost:6840"


def _arg(position: int, fallback: str) -> str:
    args = sys.argv[1:]
    return args[position] if position < len(args) else fallback


def _resolve_token_url(realm: str) -> str:
    explicit = os.getenv("OPENID_TOKEN_URL")
    if explicit:
        return explicit
    keycloak = os.getenv("KEYCLOAK_BASE_URL")
    if not keycloak:
        return f"{os.getenv('BACKEND_BASE_URL', _DEFAULT_BACKEND)}/openid/token"
    if "/realms" in keycloak:
        return f"{keycloak}{_TOKEN_PATH}"
    return f"{keycloak}/realms/{urllib.parse.quote(realm, safe='')}{_TOKEN_PATH}"


def _basic_auth_header(client_id: str, client_secret: str) -> str:
    raw = f"{client_id}:{client_secret}".encode("ascii")
    return "Basic " + base64.b64encode(raw).decode("ascii")


def main() -> None:
    username = _arg(0, "admin")
    password = _arg(1, "admin")
    realm = _arg(2, "m8flow")

    client_id = os.getenv("BACKEND_CLIENT_ID", "m8flow-backend")
    client_secret = os.getenv(
        "BACKEND_CLIENT_secret", "f041b49ae7f1a35daa10917459814bcd"
    )

    response = requests.post(
        _resolve_token_url(realm),
        data={
            "grant_type": "password",
            "code": username + _LOCAL_DEV_GRANT_SUFFIX,
            "username": username,
            "password": password,
            "client_id": client_id,
        },
        headers={
            "Content-Type": "application/x-www-form-urlencoded",
            "Authorization": _basic_auth_header(client_id, client_secret),
        },
        timeout=15,
    )

    for field, value in json.loads(response.text).items():
        if field == "access_token":  # noqa: S105
            print(value, end="")
            sys.stdout.flush()
            print(f"\n{field} written to stdout above", file=sys.stderr)
        else:
            print(f"{field}: {value}", file=sys.stderr)


if __name__ == "__main__":
    main()
