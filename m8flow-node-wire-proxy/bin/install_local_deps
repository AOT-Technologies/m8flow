#!/usr/bin/env bash
# Install host deps + platform-matched node-wire wheels from vendor/wheels/.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT"

WHEEL_DIR="$ROOT/vendor/wheels"
PYTHON="${PYTHON:-python3}"

if [[ ! -d "$WHEEL_DIR" ]]; then
  echo "ERROR: missing $WHEEL_DIR — run bin/stage-node-wire-wheels.sh first" >&2
  exit 1
fi

os_name="$(uname -s | tr '[:upper:]' '[:lower:]')"
arch="$(uname -m)"
case "$os_name-$arch" in
  darwin-arm64|darwin-x86_64)
    TAG="macosx_10_9_universal2"
    ;;
  linux-aarch64|linux-arm64)
    TAG="linux_aarch64"
    ;;
  linux-x86_64|linux-amd64)
    TAG="linux_x86_64"
    ;;
  *)
    echo "ERROR: unsupported platform $os_name/$arch for staged wheels" >&2
    exit 1
    ;;
esac

shopt -s nullglob
runtime_matches=("$WHEEL_DIR"/node_wire_runtime-*-"${TAG}".whl)
http_matches=("$WHEEL_DIR"/node_wire_http_generic-*-"${TAG}".whl)
shopt -u nullglob

if [[ ${#runtime_matches[@]} -ne 1 || ${#http_matches[@]} -ne 1 ]]; then
  echo "ERROR: expected exactly one runtime and one http_generic wheel for tag $TAG in $WHEEL_DIR" >&2
  echo "Present:" >&2
  ls -1 "$WHEEL_DIR"/*.whl 2>/dev/null || true
  echo "Hint: stage from sibling node-wire (see vendor/wheels/README.md)." >&2
  exit 1
fi

M8FLOW_PACKAGES=(
  node_wire_m8flow_github node_wire_m8flow_n8n node_wire_m8flow_smtp
  node_wire_m8flow_slack node_wire_m8flow_salesforce
  node_wire_m8flow_stripe node_wire_m8flow_postgres
)
connector_wheels=()
shopt -s nullglob
for package in "${M8FLOW_PACKAGES[@]}"; do
  matches=("$WHEEL_DIR"/"${package}"-*-"${TAG}".whl)
  if [[ ${#matches[@]} -ne 1 ]]; then
    echo "ERROR: expected exactly one ${package} wheel for tag $TAG in $WHEEL_DIR" >&2
    echo "Hint: stage the complete node-wire wheel set (see vendor/wheels/README.md)." >&2
    exit 1
  fi
  connector_wheels+=("${matches[0]}")
done
shopt -u nullglob

"$PYTHON" -m pip install uv==0.11.1
"$PYTHON" -m uv sync --frozen --extra dev
# uv evaluates source markers for the host; on macOS it skips the Linux x86_64
# wheel paths, even when those files are not staged locally. Install the host-
# tagged wheels without re-resolving their public dependencies from the lock.
if [[ "$TAG" == "linux_x86_64" ]]; then
  echo "uv sync installed the locked linux_x86_64 node-wire wheels."
else
  "$PYTHON" -m pip install --no-deps \
    "${runtime_matches[0]}" "${http_matches[0]}" "${connector_wheels[@]}"
fi

echo "Installed host + node-wire wheels ($TAG)."
