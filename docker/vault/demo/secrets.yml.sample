# Copy this file to docker/vault/demo/secrets.yml and edit the values locally.
# The vault-demo bootstrap resolves the "m8flow" alias to the canonical seeded
# tenant UUID before writing the secrets into Vault.
tenants:
  m8flow:
    secrets:
      SMTP_PASSWORD: demo-smtp-password
      API_TOKEN: demo-api-token
      SLACK_WEBHOOK_URL: https://example.invalid/hooks/demo
