# Copy this file to docker/vault/demo/secrets.yml and edit the values locally.
# Values are seeded into the named configuration-variable catalog after backend
# migrations. Only entries marked sensitive are written to Vault.
tenants:
  m8flow:
    variables:
      SMTP_HOST:
        description: SMTP server hostname
        sensitive: false
        value: sandbox.smtp.mailtrap.io
      SMTP_PORT:
        description: SMTP server port
        sensitive: false
        value: 587
      SMTP_USER:
        description: SMTP account username
        sensitive: true
        value: demo-smtp-user
      SMTP_PASSWORD:
        description: SMTP account password
        sensitive: true
        value: demo-smtp-password
      API_TOKEN:
        description: Demo API token
        sensitive: true
        value: demo-api-token
      SLACK_WEBHOOK_URL:
        description: Demo Slack webhook URL
        sensitive: true
        value: https://example.invalid/hooks/demo
