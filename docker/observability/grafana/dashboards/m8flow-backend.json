{
  "uid": "m8flow-backend",
  "title": "M8Flow Backend Overview",
  "tags": ["m8flow", "backend"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 11,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "m8flow_tenant_id",
        "type": "textbox",
        "label": "m8flow_tenant_id",
        "query": ".*",
        "current": { "text": ".*", "value": ".*" },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "text",
      "title": "Backend API",
      "gridPos": { "h": 2, "w": 24, "x": 0, "y": 0 },
      "options": {
        "mode": "markdown",
        "content": "HTTP rate/5xx from `uvicorn.access`. p99 from `request completed` `duration_ms`. ERROR is JSON `level` ERROR|CRITICAL. Process instances and tasks live on **M8Flow Application Health**. Empty ranges show **0**."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "HTTP request rate",
      "description": "Average req/s from uvicorn.access JSON logs over the selected time range.",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 2 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"m8flow-backend\"} | json | __error__=\"\" | logger=\"uvicorn.access\" [$__range])) / $__range_s or vector(0)",
          "legendFormat": "req/s",
          "queryType": "instant"
        }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "noValue": "0", "min": 0, "decimals": 3, "unit": "reqps" }, "overrides": [] }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP 5xx rate %",
      "description": "Share of uvicorn.access lines whose status is 5xx. This is the HTTP error rate, not process-instance failures.",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 2 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(count_over_time({service_name=\"m8flow-backend\"} | json | __error__=\"\" | logger=\"uvicorn.access\" | message =~ \" 5[0-9]{2}$\" [$__range])) / clamp_min(sum(count_over_time({service_name=\"m8flow-backend\"} | json | __error__=\"\" | logger=\"uvicorn.access\" [$__range])), 1) or vector(0)",
          "legendFormat": "5xx",
          "queryType": "instant"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "noValue": "0", "min": 0, "decimals": 2 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP p99 latency",
      "description": "p99 of Flask `duration_ms` on `request completed` logs. Health `/v1.0/status` is excluded.",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 2 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "quantile_over_time(0.99, {service_name=\"m8flow-backend\"} |= \"request completed\" | json | __error__=\"\" | unwrap duration_ms [$__range]) or vector(0)",
          "legendFormat": "p99",
          "queryType": "instant"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms", "noValue": "0", "min": 0, "decimals": 1 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Log ERROR lines (backend API)",
      "description": "JSON `level` ERROR or CRITICAL. Process crashes, unhandled exceptions, 5xx handlers.",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"m8flow-backend\"} | json | __error__=\"\" | level=~\"ERROR|CRITICAL\" [$__interval])) or vector(0)",
          "legendFormat": "ERROR+",
          "queryType": "range"
        }
      ],
      "options": {},
      "fieldConfig": { "defaults": { "noValue": "0", "min": 0, "custom": { "spanNulls": true } }, "overrides": [] }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "API errors by error_code",
      "description": "From JSON `error_code` on request error logs (ApiError / HTTPException / internal_error).",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (error_code) (count_over_time({service_name=\"m8flow-backend\"} | json | __error__=\"\" | error_code != \"\" [$__interval])) or vector(0)",
          "legendFormat": "{{error_code}}",
          "queryType": "range"
        }
      ],
      "options": {},
      "fieldConfig": { "defaults": { "noValue": "0", "min": 0, "custom": { "spanNulls": true } }, "overrides": [] }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "HTTP 4xx vs 5xx",
      "description": "uvicorn.access status class over time. 4xx is client/RBAC; 5xx is server.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service_name=\"m8flow-backend\"} | json | __error__=\"\" | logger=\"uvicorn.access\" | message =~ \" 4[0-9]{2}$\" [$__interval])) or vector(0)",
          "legendFormat": "4xx",
          "queryType": "range"
        },
        {
          "refId": "B",
          "expr": "sum(count_over_time({service_name=\"m8flow-backend\"} | json | __error__=\"\" | logger=\"uvicorn.access\" | message =~ \" 5[0-9]{2}$\" [$__interval])) or vector(0)",
          "legendFormat": "5xx",
          "queryType": "range"
        }
      ],
      "options": {},
      "fieldConfig": { "defaults": { "noValue": "0", "min": 0, "custom": { "spanNulls": true } }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Backend API logs (JSON)",
      "description": "Filter in Explore with | tenant_id=`…` or | error_code=`…` or | request_id=`…`.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 13 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"m8flow-backend\"} | json | __error__=\"\" | tenant_id=~`$m8flow_tenant_id`",
          "queryType": "range"
        }
      ],
      "options": { "showTime": true, "enableLogDetails": true, "sortOrder": "Descending" },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Celery worker logs",
      "description": "Background jobs (scheduler, async work). Plaintext — do not add `| json`.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"m8flow-celery-worker\"}",
          "queryType": "range"
        }
      ],
      "options": { "showTime": true, "sortOrder": "Descending" },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    }
  ],
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "M8Flow Application Health",
      "url": "/d/m8flow-application/m8flow-application-health",
      "type": "link"
    },
    {
      "title": "M8Flow SQL / Postgres",
      "url": "/d/m8flow-postgres/m8flow-sql-postgres",
      "type": "link"
    },
    {
      "title": "Tempo Service Graph",
      "url": "/a/grafana-explore-app/explore?schemaVersion=1&panes=%7B%22tempo%22:%7B%22datasource%22:%22tempo%22%7D%7D",
      "type": "link"
    }
  ]
}
