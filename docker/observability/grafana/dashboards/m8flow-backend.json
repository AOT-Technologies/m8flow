{
  "uid": "m8flow-backend",
  "title": "M8Flow Backend Overview",
  "tags": [
    "m8flow",
    "backend"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Environment / Namespace",
        "type": "custom",
        "query": "qa,dev,demo,monitoring",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "qa",
            "value": "qa"
          },
          {
            "selected": false,
            "text": "dev",
            "value": "dev"
          },
          {
            "selected": false,
            "text": "demo",
            "value": "demo"
          },
          {
            "selected": false,
            "text": "monitoring",
            "value": "monitoring"
          }
        ],
        "includeAll": true,
        "multi": true,
        "hide": 0,
        "skipUrlSync": false,
        "allValue": ".*"
      },
      {
        "name": "m8flow_tenant_id",
        "type": "textbox",
        "label": "m8flow_tenant_id",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 10,
      "type": "text",
      "title": "Metrics vs logs",
      "gridPos": {
        "h": 2,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "HTTP panels use OTel ASGI metrics (`http_server_duration_milliseconds_*`, label `job=m8flow-backend`). Requires `OTEL_SDK_DISABLED=false`, observability stack running, and a backend image with `[flask,asgi]` telemetry deps. Process/task panels need real workflow activity."
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "HTTP request rate",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_duration_milliseconds_count{job=\"m8flow-backend\"}[$__rate_interval]))",
          "legendFormat": "req/s"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HTTP 5xx rate %",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_server_duration_milliseconds_count{job=\"m8flow-backend\", http_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_duration_milliseconds_count{job=\"m8flow-backend\"}[$__rate_interval])), 1e-9)",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "HTTP p99 latency",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 2
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(http_server_duration_milliseconds_bucket{job=\"m8flow-backend\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Process instances created",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(process_instance_created_total{job=\"m8flow-backend\", m8flow_tenant_id=~\"$m8flow_tenant_id|.*\"}[$__rate_interval])) or sum(rate(process_instance_created{job=\"m8flow-backend\", m8flow_tenant_id=~\"$m8flow_tenant_id|.*\"}[$__rate_interval]))",
          "legendFormat": "created/s"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Task completed",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_type) (rate(task_completed_total{job=\"m8flow-backend\", m8flow_tenant_id=~\"$m8flow_tenant_id|.*\"}[$__rate_interval])) or sum by (task_type) (rate(task_completed{job=\"m8flow-backend\", m8flow_tenant_id=~\"$m8flow_tenant_id|.*\"}[$__rate_interval]))",
          "legendFormat": "{{task_type}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Log error lines (backend API)",
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=~\"$namespace\", app=\"m8flow-backend\"} |~ \"(?i)(error|exception|fatal)\" [$__interval]))",
          "legendFormat": "error-ish lines",
          "queryType": "range"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "logs",
      "title": "Backend API logs",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"$namespace\", app=\"m8flow-backend\"}",
          "queryType": "range"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Celery worker logs",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"$namespace\", app=\"m8flow-celery-worker\"}",
          "queryType": "range"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 101,
      "title": "Backend Pod CPU Usage",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", pod=~\".*m8flow-backend.*\", container!=\"\"}[1m])) by (pod, namespace)",
          "legendFormat": "{{namespace}} / {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 102,
      "title": "Backend Pod Memory Usage",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"$namespace\", pod=~\".*m8flow-backend.*\", container!=\"\"}) by (pod, namespace)",
          "legendFormat": "{{namespace}} / {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 103,
      "title": "Pod Restarts",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=~\"$namespace\", pod=~\".*m8flow-backend.*\"}[1h])) by (pod, namespace)",
          "legendFormat": "{{namespace}} / {{pod}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Tempo Service Graph",
      "url": "/a/grafana-explore-app/explore?schemaVersion=1&panes=%7B%22tempo%22:%7B%22datasource%22:%22tempo%22%7D%7D",
      "type": "link"
    }
  ],
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Select the Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "Select the Loki data source for logs",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ]
}