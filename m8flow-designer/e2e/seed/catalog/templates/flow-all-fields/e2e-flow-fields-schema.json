{
  "title": "E2E request",
  "description": "E2E test form (test data only).",
  "type": "object",
  "required": [
    "request_title",
    "amount",
    "priority"
  ],
  "properties": {
    "request_title": {
      "type": "string",
      "title": "Request title",
      "minLength": 3
    },
    "amount": {
      "type": "number",
      "title": "Amount"
    },
    "due_date": {
      "type": "string",
      "title": "Due date",
      "format": "date"
    },
    "priority": {
      "type": "string",
      "title": "Priority",
      "enum": [
        "Low",
        "High"
      ]
    },
    "urgent": {
      "type": "boolean",
      "title": "Urgent"
    }
  }
}
