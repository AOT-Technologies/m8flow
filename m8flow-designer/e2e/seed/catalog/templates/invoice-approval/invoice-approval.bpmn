<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by e2e/seed/tools/build_catalog.py: edit the definition there, not this file. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core"
                  id="Definitions_e2e_invoice_approval" targetNamespace="http://m8flow.org/e2e/catalog">
  <bpmn:collaboration id="Collaboration_e2e_invoice_approval"><bpmn:participant id="Participant_e2e_invoice_approval" name="E2E Invoice Approval" processRef="e2e_invoice_approval" /></bpmn:collaboration>
  
  <bpmn:process id="e2e_invoice_approval" name="E2E Invoice Approval" isExecutable="true">
    <bpmn:documentation>Accounts payable enters a supplier invoice; tax and total are calculated, new vendors are checked in the vendor registry, a manager approves it and finance records and schedules the payment.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_e2e_invoice_approval"><bpmn:lane id="Lane_submitters" name="Submitters"><bpmn:flowNodeRef>start_invoice</bpmn:flowNodeRef><bpmn:flowNodeRef>enter_invoice</bpmn:flowNodeRef><bpmn:flowNodeRef>calculate_totals</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_vendor</bpmn:flowNodeRef><bpmn:flowNodeRef>check_vendor</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_vendor_done</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_approvers" name="Approvers"><bpmn:flowNodeRef>approve_invoice</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_invoice_approved</bpmn:flowNodeRef><bpmn:flowNodeRef>end_invoice_rejected</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_administrators" name="Administrators"><bpmn:flowNodeRef>ensure_payment_table</bpmn:flowNodeRef><bpmn:flowNodeRef>record_payment</bpmn:flowNodeRef><bpmn:flowNodeRef>schedule_payment</bpmn:flowNodeRef><bpmn:flowNodeRef>end_paid</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="start_invoice" name="Invoice received"><bpmn:outgoing>Flow_start_invoice_enter_invoice</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="enter_invoice" name="Enter invoice"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="invoice-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="invoice-uischema.json" /></spiffworkflow:properties></bpmn:extensionElements><bpmn:incoming>Flow_start_invoice_enter_invoice</bpmn:incoming><bpmn:outgoing>Flow_enter_invoice_calculate_totals</bpmn:outgoing></bpmn:userTask>
    <bpmn:scriptTask id="calculate_totals" name="Calculate totals" scriptFormat="python"><bpmn:incoming>Flow_enter_invoice_calculate_totals</bpmn:incoming><bpmn:outgoing>Flow_calculate_totals_gw_vendor</bpmn:outgoing><bpmn:script>tax = round(amount * tax_rate / 100, 2)
total = round(amount + tax, 2)</bpmn:script></bpmn:scriptTask>
    <bpmn:exclusiveGateway id="gw_vendor" name="New vendor?" default="Flow_gw_vendor_gw_vendor_done"><bpmn:incoming>Flow_calculate_totals_gw_vendor</bpmn:incoming><bpmn:outgoing>Flow_gw_vendor_check_vendor</bpmn:outgoing><bpmn:outgoing>Flow_gw_vendor_gw_vendor_done</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="check_vendor" name="Check vendor registry"><bpmn:extensionElements><spiffworkflow:serviceTaskOperator id="http/GetRequestV2" resultVariable="vendor_check"><spiffworkflow:parameters><spiffworkflow:parameter id="url" type="any" value='"http://vendor-registry.e2e.invalid/vendors"' /><spiffworkflow:parameter id="params" type="any" value="{'name': vendor}" /></spiffworkflow:parameters></spiffworkflow:serviceTaskOperator><spiffworkflow:postScript>vendor_status = vendor_check['command_response']['http_status']</spiffworkflow:postScript></bpmn:extensionElements><bpmn:incoming>Flow_gw_vendor_check_vendor</bpmn:incoming><bpmn:outgoing>Flow_check_vendor_gw_vendor_done</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="gw_vendor_done"><bpmn:incoming>Flow_check_vendor_gw_vendor_done</bpmn:incoming><bpmn:incoming>Flow_gw_vendor_gw_vendor_done</bpmn:incoming><bpmn:outgoing>Flow_gw_vendor_done_approve_invoice</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="approve_invoice" name="Approve invoice"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="approval-decision-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="approval-decision-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>Invoice {{ invoice_number }} from {{ vendor }}: {{ amount }} + tax {{ tax }} = {{ total }}.</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_gw_vendor_done_approve_invoice</bpmn:incoming><bpmn:outgoing>Flow_approve_invoice_gw_invoice_approved</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_invoice_approved" name="Approved?" default="Flow_gw_invoice_approved_ensure_payment_table"><bpmn:incoming>Flow_approve_invoice_gw_invoice_approved</bpmn:incoming><bpmn:outgoing>Flow_gw_invoice_approved_end_invoice_rejected</bpmn:outgoing><bpmn:outgoing>Flow_gw_invoice_approved_ensure_payment_table</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_invoice_rejected" name="Invoice rejected"><bpmn:incoming>Flow_gw_invoice_approved_end_invoice_rejected</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="ensure_payment_table" name="Ensure payment table"><bpmn:extensionElements><spiffworkflow:serviceTaskOperator id="postgres_v2/DoSQL" resultVariable="payment_table"><spiffworkflow:parameters><spiffworkflow:parameter id="m8flow_profile" type="any" value='"e2e"' /><spiffworkflow:parameter id="database_connection_str" type="any" /><spiffworkflow:parameter id="schema" type="any" value="{'sql': 'CREATE TABLE IF NOT EXISTS e2e_invoice_payments (id serial PRIMARY KEY, vendor text, total numeric, created_at timestamptz DEFAULT now())'}" /></spiffworkflow:parameters></spiffworkflow:serviceTaskOperator></bpmn:extensionElements><bpmn:incoming>Flow_gw_invoice_approved_ensure_payment_table</bpmn:incoming><bpmn:outgoing>Flow_ensure_payment_table_record_payment</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="record_payment" name="Record payment"><bpmn:extensionElements><spiffworkflow:serviceTaskOperator id="postgres_v2/DoSQL" resultVariable="payment_row"><spiffworkflow:parameters><spiffworkflow:parameter id="m8flow_profile" type="any" value='"e2e"' /><spiffworkflow:parameter id="database_connection_str" type="any" /><spiffworkflow:parameter id="schema" type="any" value="{'sql': 'INSERT INTO e2e_invoice_payments (vendor, total) VALUES (%s, %s) RETURNING id', 'values': [vendor, total], 'fetch_results': True}" /></spiffworkflow:parameters></spiffworkflow:serviceTaskOperator><spiffworkflow:postScript>payment_id = payment_row['command_response']['body']['body'][0][0]</spiffworkflow:postScript></bpmn:extensionElements><bpmn:incoming>Flow_ensure_payment_table_record_payment</bpmn:incoming><bpmn:outgoing>Flow_record_payment_schedule_payment</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:manualTask id="schedule_payment" name="Schedule payment"><bpmn:extensionElements><spiffworkflow:instructionsForEndUser>Pay {{ total }} to {{ vendor }} (invoice {{ invoice_number }}), then click Submit.</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_record_payment_schedule_payment</bpmn:incoming><bpmn:outgoing>Flow_schedule_payment_end_paid</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="end_paid" name="Invoice paid"><bpmn:incoming>Flow_schedule_payment_end_paid</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_invoice_enter_invoice" sourceRef="start_invoice" targetRef="enter_invoice"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_enter_invoice_calculate_totals" sourceRef="enter_invoice" targetRef="calculate_totals"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_calculate_totals_gw_vendor" sourceRef="calculate_totals" targetRef="gw_vendor"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_check_vendor_gw_vendor_done" sourceRef="check_vendor" targetRef="gw_vendor_done"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_vendor_done_approve_invoice" sourceRef="gw_vendor_done" targetRef="approve_invoice"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_approve_invoice_gw_invoice_approved" sourceRef="approve_invoice" targetRef="gw_invoice_approved"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ensure_payment_table_record_payment" sourceRef="ensure_payment_table" targetRef="record_payment"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_record_payment_schedule_payment" sourceRef="record_payment" targetRef="schedule_payment"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_schedule_payment_end_paid" sourceRef="schedule_payment" targetRef="end_paid"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_vendor_check_vendor" name="new vendor" sourceRef="gw_vendor" targetRef="check_vendor"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">new_vendor == True</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_vendor_gw_vendor_done" name="known vendor" sourceRef="gw_vendor" targetRef="gw_vendor_done"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_invoice_approved_end_invoice_rejected" name="Reject" sourceRef="gw_invoice_approved" targetRef="end_invoice_rejected"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == 'reject'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_invoice_approved_ensure_payment_table" name="Approve" sourceRef="gw_invoice_approved" targetRef="ensure_payment_table"></bpmn:sequenceFlow>
    <bpmn:textAnnotation id="note_registry"><bpmn:text>The vendor registry is not reachable from the E2E stack: a new vendor shows how a failing connector call is reported</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_note_registry" sourceRef="check_vendor" targetRef="note_registry" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_e2e_invoice_approval">
    <bpmndi:BPMNPlane id="BPMNPlane_e2e_invoice_approval" bpmnElement="Collaboration_e2e_invoice_approval">
      <bpmndi:BPMNShape id="Participant_e2e_invoice_approval_di" bpmnElement="Participant_e2e_invoice_approval" isHorizontal="true"><dc:Bounds x="130" y="60" width="2063.0" height="600" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_submitters_di" bpmnElement="Lane_submitters" isHorizontal="true"><dc:Bounds x="160" y="60" width="2033.0" height="300" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_approvers_di" bpmnElement="Lane_approvers" isHorizontal="true"><dc:Bounds x="160" y="360" width="2033.0" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_administrators_di" bpmnElement="Lane_administrators" isHorizontal="true"><dc:Bounds x="160" y="510" width="2033.0" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_invoice_di" bpmnElement="start_invoice"><dc:Bounds x="262" y="117" width="36" height="36" /></bpmndi:BPMNShape>
