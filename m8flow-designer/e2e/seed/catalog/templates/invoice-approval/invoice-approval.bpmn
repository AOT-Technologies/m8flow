      <bpmndi:BPMNEdge id="Flow_check_vendor_gw_vendor_done_di" bpmnElement="Flow_check_vendor_gw_vendor_done"><di:waypoint x="990" y="285" /><di:waypoint x="1105" y="285" /><di:waypoint x="1105" y="160" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_gw_vendor_done_approve_invoice_di" bpmnElement="Flow_gw_vendor_done_approve_invoice"><di:waypoint x="1105" y="160" /><di:waypoint x="1105" y="435" /><di:waypoint x="1220" y="435" /></bpmndi:BPMNEdge>
