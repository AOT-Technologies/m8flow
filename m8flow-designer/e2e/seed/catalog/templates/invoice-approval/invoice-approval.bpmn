      <bpmndi:BPMNShape id="end_invoice_rejected_di" bpmnElement="end_invoice_rejected"><dc:Bounds x="1582" y="417" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ensure_payment_table_di" bpmnElement="ensure_payment_table"><dc:Bounds x="1550" y="545" width="100" height="80" /></bpmndi:BPMNShape>
