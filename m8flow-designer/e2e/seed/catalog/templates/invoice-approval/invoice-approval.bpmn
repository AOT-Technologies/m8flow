      <bpmndi:BPMNEdge id="Flow_start_invoice_enter_invoice_di" bpmnElement="Flow_start_invoice_enter_invoice"><di:waypoint x="298" y="135" /><di:waypoint x="395" y="135" /></bpmndi:BPMNEdge>
