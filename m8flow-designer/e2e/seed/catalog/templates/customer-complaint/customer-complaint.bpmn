                  xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core"
                  id="Definitions_e2e_customer_complaint" targetNamespace="http://m8flow.org/e2e/catalog">
  <bpmn:collaboration id="Collaboration_e2e_customer_complaint"><bpmn:participant id="Participant_e2e_customer_complaint" name="E2E Customer Complaint" processRef="e2e_customer_complaint" /></bpmn:collaboration>
  <bpmn:signal id="Signal_resolved" name="complaint_resolved" />
  <bpmn:signal id="Signal_escalated" name="complaint_escalated" />
  <bpmn:error id="Error_refund_limit" name="Refund over limit" errorCode="REFUND_LIMIT" />
  <bpmn:process id="e2e_customer_complaint" name="E2E Customer Complaint" isExecutable="true">
    <bpmn:documentation>A support agent logs a complaint. A decision table routes it; short complaints are sent back for more details until complete. A supervisor investigates and signals whether it is resolved or escalated; refunds over the limit raise an error that finance must approve before the case is closed.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_e2e_customer_complaint"><bpmn:lane id="Lane_submitters" name="Submitters"><bpmn:flowNodeRef>start_complaint</bpmn:flowNodeRef><bpmn:flowNodeRef>log_complaint</bpmn:flowNodeRef><bpmn:flowNodeRef>classify</bpmn:flowNodeRef><bpmn:flowNodeRef>ack_complaint</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_details</bpmn:flowNodeRef><bpmn:flowNodeRef>request_info</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_details_done</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_fork</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_wait</bpmn:flowNodeRef><bpmn:flowNodeRef>catch_resolved</bpmn:flowNodeRef><bpmn:flowNodeRef>catch_escalated</bpmn:flowNodeRef><bpmn:flowNodeRef>confirm_customer</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_resolution</bpmn:flowNodeRef><bpmn:flowNodeRef>mark_ready</bpmn:flowNodeRef><bpmn:flowNodeRef>catch_ready</bpmn:flowNodeRef><bpmn:flowNodeRef>refund</bpmn:flowNodeRef><bpmn:flowNodeRef>b_over_limit</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_refund_done</bpmn:flowNodeRef><bpmn:flowNodeRef>close_case</bpmn:flowNodeRef><bpmn:flowNodeRef>end_closed</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_approvers" name="Approvers"><bpmn:flowNodeRef>investigate</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_outcome</bpmn:flowNodeRef><bpmn:flowNodeRef>throw_resolved</bpmn:flowNodeRef><bpmn:flowNodeRef>end_investigated</bpmn:flowNodeRef><bpmn:flowNodeRef>throw_escalated</bpmn:flowNodeRef><bpmn:flowNodeRef>end_investigated_escalated</bpmn:flowNodeRef><bpmn:flowNodeRef>supervisor_review</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_administrators" name="Administrators"><bpmn:flowNodeRef>approve_refund</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="start_complaint" name="Complaint received"><bpmn:outgoing>Flow_start_complaint_log_complaint</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="log_complaint" name="Log complaint"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="complaint-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="complaint-uischema.json" /></spiffworkflow:properties></bpmn:extensionElements><bpmn:incoming>Flow_start_complaint_log_complaint</bpmn:incoming><bpmn:outgoing>Flow_log_complaint_classify</bpmn:outgoing></bpmn:userTask>
    <bpmn:businessRuleTask id="classify" name="Classify complaint"><bpmn:extensionElements><spiffworkflow:calledDecisionId>complaint_routing</spiffworkflow:calledDecisionId><spiffworkflow:postScript>refund_limit = 500</spiffworkflow:postScript></bpmn:extensionElements><bpmn:incoming>Flow_log_complaint_classify</bpmn:incoming><bpmn:outgoing>Flow_classify_ack_complaint</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:task id="ack_complaint" name="Acknowledge complaint"><bpmn:extensionElements><spiffworkflow:instructionsForEndUser>Tell {{ customer }} that the {{ team }} team replies within {{ response_hours }} hours, then click Submit.</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_classify_ack_complaint</bpmn:incoming><bpmn:outgoing>Flow_ack_complaint_gw_details</bpmn:outgoing></bpmn:task>
    <bpmn:exclusiveGateway id="gw_details" name="Details complete?" default="Flow_gw_details_gw_details_done"><bpmn:incoming>Flow_ack_complaint_gw_details</bpmn:incoming><bpmn:outgoing>Flow_gw_details_request_info</bpmn:outgoing><bpmn:outgoing>Flow_gw_details_gw_details_done</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="request_info" name="Request more details"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="more-details-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="more-details-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>The complaint needs at least 20 characters of detail. Ask {{ customer }} for more.</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_gw_details_request_info</bpmn:incoming><bpmn:outgoing>Flow_request_info_gw_details_done</bpmn:outgoing><bpmn:standardLoopCharacteristics loopMaximum="3"><bpmn:loopCondition xsi:type="bpmn:tFormalExpression">not info_complete</bpmn:loopCondition></bpmn:standardLoopCharacteristics></bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_details_done"><bpmn:incoming>Flow_request_info_gw_details_done</bpmn:incoming><bpmn:incoming>Flow_gw_details_gw_details_done</bpmn:incoming><bpmn:outgoing>Flow_gw_details_done_gw_fork</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_fork"><bpmn:incoming>Flow_gw_details_done_gw_fork</bpmn:incoming><bpmn:outgoing>Flow_gw_fork_investigate</bpmn:outgoing><bpmn:outgoing>Flow_gw_fork_gw_wait</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="investigate" name="Investigate complaint"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="investigation-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="investigation-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>{{ category }} complaint from {{ customer }} ({{ severity }}): {{ details }}</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_gw_fork_investigate</bpmn:incoming><bpmn:outgoing>Flow_investigate_gw_outcome</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_outcome" name="Outcome" default="Flow_gw_outcome_throw_resolved"><bpmn:incoming>Flow_investigate_gw_outcome</bpmn:incoming><bpmn:outgoing>Flow_gw_outcome_throw_escalated</bpmn:outgoing><bpmn:outgoing>Flow_gw_outcome_throw_resolved</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="throw_resolved" name="Resolved"><bpmn:incoming>Flow_gw_outcome_throw_resolved</bpmn:incoming><bpmn:outgoing>Flow_throw_resolved_end_investigated</bpmn:outgoing><bpmn:signalEventDefinition signalRef="Signal_resolved" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_investigated" name="Investigation done"><bpmn:incoming>Flow_throw_resolved_end_investigated</bpmn:incoming></bpmn:endEvent>
    <bpmn:intermediateThrowEvent id="throw_escalated" name="Escalated"><bpmn:incoming>Flow_gw_outcome_throw_escalated</bpmn:incoming><bpmn:outgoing>Flow_throw_escalated_end_investigated_escalated</bpmn:outgoing><bpmn:signalEventDefinition signalRef="Signal_escalated" /></bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="end_investigated_escalated" name="Investigation escalated"><bpmn:incoming>Flow_throw_escalated_end_investigated_escalated</bpmn:incoming></bpmn:endEvent>
    <bpmn:eventBasedGateway id="gw_wait" name="Resolved or escalated?"><bpmn:incoming>Flow_gw_fork_gw_wait</bpmn:incoming><bpmn:outgoing>Flow_gw_wait_catch_resolved</bpmn:outgoing><bpmn:outgoing>Flow_gw_wait_catch_escalated</bpmn:outgoing></bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="catch_resolved" name="Resolved"><bpmn:incoming>Flow_gw_wait_catch_resolved</bpmn:incoming><bpmn:outgoing>Flow_catch_resolved_confirm_customer</bpmn:outgoing><bpmn:signalEventDefinition signalRef="Signal_resolved" /></bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="catch_escalated" name="Escalated"><bpmn:incoming>Flow_gw_wait_catch_escalated</bpmn:incoming><bpmn:outgoing>Flow_catch_escalated_supervisor_review</bpmn:outgoing><bpmn:signalEventDefinition signalRef="Signal_escalated" /></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="confirm_customer" name="Confirm with customer"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="confirmation-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="confirmation-uischema.json" /></spiffworkflow:properties></bpmn:extensionElements><bpmn:incoming>Flow_catch_resolved_confirm_customer</bpmn:incoming><bpmn:outgoing>Flow_confirm_customer_gw_resolution</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="supervisor_review" name="Supervisor review"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="supervisor-review-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="supervisor-review-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>Escalated: {{ details }}. Set the refund (0 for none).</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_catch_escalated_supervisor_review</bpmn:incoming><bpmn:outgoing>Flow_supervisor_review_gw_resolution</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_resolution"><bpmn:incoming>Flow_confirm_customer_gw_resolution</bpmn:incoming><bpmn:incoming>Flow_supervisor_review_gw_resolution</bpmn:incoming><bpmn:outgoing>Flow_gw_resolution_mark_ready</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="mark_ready" name="Mark case ready" scriptFormat="python"><bpmn:incoming>Flow_gw_resolution_mark_ready</bpmn:incoming><bpmn:outgoing>Flow_mark_ready_catch_ready</bpmn:outgoing><bpmn:script>case_ready = True</bpmn:script></bpmn:scriptTask>
    <bpmn:intermediateCatchEvent id="catch_ready" name="Case ready?"><bpmn:incoming>Flow_mark_ready_catch_ready</bpmn:incoming><bpmn:outgoing>Flow_catch_ready_refund</bpmn:outgoing><bpmn:conditionalEventDefinition><bpmn:condition xsi:type="bpmn:tFormalExpression">case_ready == True</bpmn:condition></bpmn:conditionalEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:subProcess id="refund" name="Refund check"><bpmn:incoming>Flow_catch_ready_refund</bpmn:incoming><bpmn:outgoing>Flow_refund_gw_refund_done</bpmn:outgoing>
      <bpmn:startEvent id="refund_start"><bpmn:outgoing>Flow_refund_start_check_limit</bpmn:outgoing></bpmn:startEvent>
      <bpmn:scriptTask id="check_limit" name="Check refund limit" scriptFormat="python"><bpmn:incoming>Flow_refund_start_check_limit</bpmn:incoming><bpmn:outgoing>Flow_check_limit_gw_refund</bpmn:outgoing><bpmn:script>over_limit = refund_amount &gt; refund_limit</bpmn:script></bpmn:scriptTask>
      <bpmn:exclusiveGateway id="gw_refund" name="Over the limit?" default="Flow_gw_refund_refund_ok"><bpmn:incoming>Flow_check_limit_gw_refund</bpmn:incoming><bpmn:outgoing>Flow_gw_refund_refund_over</bpmn:outgoing><bpmn:outgoing>Flow_gw_refund_refund_ok</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="refund_ok" name="Within limit"><bpmn:incoming>Flow_gw_refund_refund_ok</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="refund_over" name="Over limit"><bpmn:incoming>Flow_gw_refund_refund_over</bpmn:incoming><bpmn:errorEventDefinition errorRef="Error_refund_limit" /></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_refund_start_check_limit" sourceRef="refund_start" targetRef="check_limit"></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_check_limit_gw_refund" sourceRef="check_limit" targetRef="gw_refund"></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw_refund_refund_over" name="over limit" sourceRef="gw_refund" targetRef="refund_over"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">over_limit == True</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw_refund_refund_ok" name="ok" sourceRef="gw_refund" targetRef="refund_ok"></bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="b_over_limit" name="Over limit" attachedToRef="refund"><bpmn:outgoing>Flow_b_over_limit_approve_refund</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_refund_limit" /></bpmn:boundaryEvent>
    <bpmn:userTask id="approve_refund" name="Approve refund"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="refund-approval-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="refund-approval-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>Refund of {{ refund_amount }} for {{ customer }} is over the {{ refund_limit }} limit.</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_b_over_limit_approve_refund</bpmn:incoming><bpmn:outgoing>Flow_approve_refund_gw_refund_done</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_refund_done"><bpmn:incoming>Flow_approve_refund_gw_refund_done</bpmn:incoming><bpmn:incoming>Flow_refund_gw_refund_done</bpmn:incoming><bpmn:outgoing>Flow_gw_refund_done_close_case</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="close_case" name="Close case"><bpmn:extensionElements><spiffworkflow:instructionsForEndUser>Case for {{ customer }} closed. Refund: {{ refund_amount }}. Click Submit to finish.</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_gw_refund_done_close_case</bpmn:incoming><bpmn:outgoing>Flow_close_case_end_closed</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="end_closed" name="Case closed"><bpmn:incoming>Flow_close_case_end_closed</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_complaint_log_complaint" sourceRef="start_complaint" targetRef="log_complaint"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_log_complaint_classify" sourceRef="log_complaint" targetRef="classify"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_classify_ack_complaint" sourceRef="classify" targetRef="ack_complaint"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ack_complaint_gw_details" sourceRef="ack_complaint" targetRef="gw_details"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_request_info_gw_details_done" sourceRef="request_info" targetRef="gw_details_done"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_details_done_gw_fork" sourceRef="gw_details_done" targetRef="gw_fork"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_fork_investigate" sourceRef="gw_fork" targetRef="investigate"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_fork_gw_wait" sourceRef="gw_fork" targetRef="gw_wait"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_investigate_gw_outcome" sourceRef="investigate" targetRef="gw_outcome"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_throw_resolved_end_investigated" sourceRef="throw_resolved" targetRef="end_investigated"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_throw_escalated_end_investigated_escalated" sourceRef="throw_escalated" targetRef="end_investigated_escalated"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_wait_catch_resolved" sourceRef="gw_wait" targetRef="catch_resolved"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_wait_catch_escalated" sourceRef="gw_wait" targetRef="catch_escalated"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_catch_resolved_confirm_customer" sourceRef="catch_resolved" targetRef="confirm_customer"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_catch_escalated_supervisor_review" sourceRef="catch_escalated" targetRef="supervisor_review"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_confirm_customer_gw_resolution" sourceRef="confirm_customer" targetRef="gw_resolution"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_supervisor_review_gw_resolution" sourceRef="supervisor_review" targetRef="gw_resolution"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_resolution_mark_ready" sourceRef="gw_resolution" targetRef="mark_ready"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_mark_ready_catch_ready" sourceRef="mark_ready" targetRef="catch_ready"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_catch_ready_refund" sourceRef="catch_ready" targetRef="refund"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_b_over_limit_approve_refund" sourceRef="b_over_limit" targetRef="approve_refund"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_approve_refund_gw_refund_done" sourceRef="approve_refund" targetRef="gw_refund_done"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_refund_gw_refund_done" sourceRef="refund" targetRef="gw_refund_done"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_refund_done_close_case" sourceRef="gw_refund_done" targetRef="close_case"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_close_case_end_closed" sourceRef="close_case" targetRef="end_closed"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_details_request_info" name="too short" sourceRef="gw_details" targetRef="request_info"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">len(details) &lt; 20</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_details_gw_details_done" name="complete" sourceRef="gw_details" targetRef="gw_details_done"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_outcome_throw_escalated" name="escalate" sourceRef="gw_outcome" targetRef="throw_escalated"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">resolution == 'escalate'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_outcome_throw_resolved" name="resolved" sourceRef="gw_outcome" targetRef="throw_resolved"></bpmn:sequenceFlow>
    <bpmn:textAnnotation id="note_signals"><bpmn:text>The supervisor's outcome is signalled to the agent's event gateway</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_note_signals" sourceRef="gw_wait" targetRef="note_signals" />
  </bpmn:process>
