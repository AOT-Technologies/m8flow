<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core"
                  id="Definitions_e2e_travel_request" targetNamespace="http://m8flow.org/e2e/catalog">
  <bpmn:collaboration id="Collaboration_e2e_travel_request"><bpmn:participant id="Participant_e2e_travel_request" name="E2E Travel Request" processRef="e2e_travel_request" /><bpmn:participant id="Participant_travel_agency" name="Travel agency" /><bpmn:messageFlow id="MessageFlow_itinerary" name="Itinerary" sourceRef="send_itinerary" targetRef="Participant_travel_agency" messageRef="Message_itinerary" /></bpmn:collaboration>
  <bpmn:message id="Message_itinerary" name="itinerary" />
  <bpmn:category id="Category_group_approvals"><bpmn:categoryValue id="CategoryValue_group_approvals" value="Approvals" /></bpmn:category>
  <bpmn:process id="e2e_travel_request" name="E2E Travel Request" isExecutable="true">
    <bpmn:documentation>An employee requests a business trip. A decision table sets the approval level; the manager is reminded and the request goes to finance when it is overdue. Approved trips are booked while the budget hold is recorded in the database, then the itinerary is sent to the travel agency.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_e2e_travel_request"><bpmn:lane id="Lane_submitters" name="Submitters"><bpmn:flowNodeRef>start_trip</bpmn:flowNodeRef><bpmn:flowNodeRef>submit_trip</bpmn:flowNodeRef><bpmn:flowNodeRef>decide_route</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_route</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_approved</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_fork</bpmn:flowNodeRef><bpmn:flowNodeRef>book_travel</bpmn:flowNodeRef><bpmn:flowNodeRef>ensure_hold_table</bpmn:flowNodeRef><bpmn:flowNodeRef>record_hold</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_join</bpmn:flowNodeRef><bpmn:flowNodeRef>send_itinerary</bpmn:flowNodeRef><bpmn:flowNodeRef>end_booked</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_approvers" name="Approvers"><bpmn:flowNodeRef>manager_approval</bpmn:flowNodeRef><bpmn:flowNodeRef>b_reminder</bpmn:flowNodeRef><bpmn:flowNodeRef>b_overdue</bpmn:flowNodeRef><bpmn:flowNodeRef>remind_manager</bpmn:flowNodeRef><bpmn:flowNodeRef>end_reminded</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_manager</bpmn:flowNodeRef><bpmn:flowNodeRef>end_rejected</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_need_finance</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_administrators" name="Administrators"><bpmn:flowNodeRef>finance_approval</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_finance</bpmn:flowNodeRef><bpmn:flowNodeRef>end_rejected_finance</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="start_trip" name="Trip needed"><bpmn:outgoing>Flow_start_trip_submit_trip</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="submit_trip" name="Submit travel request"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="trip-request-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="trip-request-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>Enter the trip. International trips and trips of 5000 or more need finance approval.</spiffworkflow:instructionsForEndUser><spiffworkflow:preScript>request_channel = 'portal'</spiffworkflow:preScript><spiffworkflow:postScript>reminders = 0</spiffworkflow:postScript></bpmn:extensionElements><bpmn:incoming>Flow_start_trip_submit_trip</bpmn:incoming><bpmn:outgoing>Flow_submit_trip_decide_route</bpmn:outgoing></bpmn:userTask>
    <bpmn:businessRuleTask id="decide_route" name="Decide approval level"><bpmn:extensionElements><spiffworkflow:calledDecisionId>travel_policy</spiffworkflow:calledDecisionId></bpmn:extensionElements><bpmn:incoming>Flow_submit_trip_decide_route</bpmn:incoming><bpmn:outgoing>Flow_decide_route_gw_route</bpmn:outgoing></bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="gw_route" name="Approval needed?" default="Flow_gw_route_gw_approved"><bpmn:incoming>Flow_decide_route_gw_route</bpmn:incoming><bpmn:outgoing>Flow_gw_route_manager_approval</bpmn:outgoing><bpmn:outgoing>Flow_gw_route_gw_approved</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="manager_approval" name="Manager approval"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="approval-decision-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="approval-decision-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>{{ destination }} for {{ nights }} night(s), estimated {{ estimated_cost }} ({{ purpose }}).</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_gw_route_manager_approval</bpmn:incoming><bpmn:outgoing>Flow_manager_approval_gw_manager</bpmn:outgoing></bpmn:userTask>
    <bpmn:boundaryEvent id="b_reminder" name="Every 10 s" attachedToRef="manager_approval" cancelActivity="false"><bpmn:outgoing>Flow_b_reminder_remind_manager</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeCycle xsi:type="bpmn:tFormalExpression">"R2/PT10S"</bpmn:timeCycle></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="b_overdue" name="Overdue 40 s" attachedToRef="manager_approval"><bpmn:outgoing>Flow_b_overdue_finance_approval</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">"PT40S"</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:boundaryEvent>
    <bpmn:scriptTask id="remind_manager" name="Remind manager" scriptFormat="python"><bpmn:incoming>Flow_b_reminder_remind_manager</bpmn:incoming><bpmn:outgoing>Flow_remind_manager_end_reminded</bpmn:outgoing><bpmn:script>reminders += 1</bpmn:script></bpmn:scriptTask>
    <bpmn:endEvent id="end_reminded" name="Reminder sent"><bpmn:incoming>Flow_remind_manager_end_reminded</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_manager" name="Manager decision" default="Flow_gw_manager_gw_need_finance"><bpmn:incoming>Flow_manager_approval_gw_manager</bpmn:incoming><bpmn:outgoing>Flow_gw_manager_end_rejected</bpmn:outgoing><bpmn:outgoing>Flow_gw_manager_gw_need_finance</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_rejected" name="Rejected by manager"><bpmn:incoming>Flow_gw_manager_end_rejected</bpmn:incoming><bpmn:terminateEventDefinition /></bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_need_finance" name="Finance needed?" default="Flow_gw_need_finance_gw_approved"><bpmn:incoming>Flow_gw_manager_gw_need_finance</bpmn:incoming><bpmn:outgoing>Flow_gw_need_finance_finance_approval</bpmn:outgoing><bpmn:outgoing>Flow_gw_need_finance_gw_approved</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="finance_approval" name="Finance approval"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="approval-decision-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="approval-decision-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>Finance check: {{ destination }}, estimated {{ estimated_cost }}, international: {{ international }}.</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_b_overdue_finance_approval</bpmn:incoming><bpmn:incoming>Flow_gw_need_finance_finance_approval</bpmn:incoming><bpmn:outgoing>Flow_finance_approval_gw_finance</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_finance" name="Finance decision" default="Flow_gw_finance_gw_approved"><bpmn:incoming>Flow_finance_approval_gw_finance</bpmn:incoming><bpmn:outgoing>Flow_gw_finance_end_rejected_finance</bpmn:outgoing><bpmn:outgoing>Flow_gw_finance_gw_approved</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:endEvent id="end_rejected_finance" name="Rejected by finance"><bpmn:incoming>Flow_gw_finance_end_rejected_finance</bpmn:incoming><bpmn:terminateEventDefinition /></bpmn:endEvent>
    <bpmn:exclusiveGateway id="gw_approved" name="Approved"><bpmn:incoming>Flow_gw_route_gw_approved</bpmn:incoming><bpmn:incoming>Flow_gw_need_finance_gw_approved</bpmn:incoming><bpmn:incoming>Flow_gw_finance_gw_approved</bpmn:incoming><bpmn:outgoing>Flow_gw_approved_gw_fork</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="gw_fork"><bpmn:incoming>Flow_gw_approved_gw_fork</bpmn:incoming><bpmn:outgoing>Flow_gw_fork_book_travel</bpmn:outgoing><bpmn:outgoing>Flow_gw_fork_ensure_hold_table</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="book_travel" name="Book travel"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="booking-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="booking-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>Book {{ nights }} night(s) in {{ destination }}.</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_gw_fork_book_travel</bpmn:incoming><bpmn:outgoing>Flow_book_travel_gw_join</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="ensure_hold_table" name="Ensure budget table"><bpmn:extensionElements><spiffworkflow:serviceTaskOperator id="postgres_v2/DoSQL" resultVariable="hold_table"><spiffworkflow:parameters><spiffworkflow:parameter id="m8flow_profile" type="any" value='"e2e"' /><spiffworkflow:parameter id="database_connection_str" type="any" /><spiffworkflow:parameter id="schema" type="any" value="{'sql': 'CREATE TABLE IF NOT EXISTS e2e_travel_holds (id serial PRIMARY KEY, destination text, amount numeric, created_at timestamptz DEFAULT now())'}" /></spiffworkflow:parameters></spiffworkflow:serviceTaskOperator></bpmn:extensionElements><bpmn:incoming>Flow_gw_fork_ensure_hold_table</bpmn:incoming><bpmn:outgoing>Flow_ensure_hold_table_record_hold</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="record_hold" name="Record budget hold"><bpmn:extensionElements><spiffworkflow:serviceTaskOperator id="postgres_v2/DoSQL" resultVariable="hold"><spiffworkflow:parameters><spiffworkflow:parameter id="m8flow_profile" type="any" value='"e2e"' /><spiffworkflow:parameter id="database_connection_str" type="any" /><spiffworkflow:parameter id="schema" type="any" value="{'sql': 'INSERT INTO e2e_travel_holds (destination, amount) VALUES (%s, %s) RETURNING id', 'values': [destination, estimated_cost], 'fetch_results': True}" /></spiffworkflow:parameters></spiffworkflow:serviceTaskOperator><spiffworkflow:postScript>hold_id = hold['command_response']['body']['body'][0][0]</spiffworkflow:postScript></bpmn:extensionElements><bpmn:incoming>Flow_ensure_hold_table_record_hold</bpmn:incoming><bpmn:outgoing>Flow_record_hold_gw_join</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:parallelGateway id="gw_join"><bpmn:incoming>Flow_book_travel_gw_join</bpmn:incoming><bpmn:incoming>Flow_record_hold_gw_join</bpmn:incoming><bpmn:outgoing>Flow_gw_join_send_itinerary</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:sendTask id="send_itinerary" name="Send itinerary" messageRef="Message_itinerary"><bpmn:incoming>Flow_gw_join_send_itinerary</bpmn:incoming><bpmn:outgoing>Flow_send_itinerary_end_booked</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="end_booked" name="Trip booked"><bpmn:incoming>Flow_send_itinerary_end_booked</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_trip_submit_trip" sourceRef="start_trip" targetRef="submit_trip"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_submit_trip_decide_route" sourceRef="submit_trip" targetRef="decide_route"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_decide_route_gw_route" sourceRef="decide_route" targetRef="gw_route"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_manager_approval_gw_manager" sourceRef="manager_approval" targetRef="gw_manager"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_b_reminder_remind_manager" sourceRef="b_reminder" targetRef="remind_manager"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_remind_manager_end_reminded" sourceRef="remind_manager" targetRef="end_reminded"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_b_overdue_finance_approval" sourceRef="b_overdue" targetRef="finance_approval"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_approved_gw_fork" sourceRef="gw_approved" targetRef="gw_fork"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_fork_book_travel" sourceRef="gw_fork" targetRef="book_travel"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_fork_ensure_hold_table" sourceRef="gw_fork" targetRef="ensure_hold_table"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ensure_hold_table_record_hold" sourceRef="ensure_hold_table" targetRef="record_hold"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_book_travel_gw_join" sourceRef="book_travel" targetRef="gw_join"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_record_hold_gw_join" sourceRef="record_hold" targetRef="gw_join"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_join_send_itinerary" sourceRef="gw_join" targetRef="send_itinerary"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_send_itinerary_end_booked" sourceRef="send_itinerary" targetRef="end_booked"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_finance_approval_gw_finance" sourceRef="finance_approval" targetRef="gw_finance"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_route_manager_approval" name="manager or finance" sourceRef="gw_route" targetRef="manager_approval"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approval_level != 'auto'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_route_gw_approved" name="auto" sourceRef="gw_route" targetRef="gw_approved"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_manager_end_rejected" name="Reject" sourceRef="gw_manager" targetRef="end_rejected"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == 'reject'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_manager_gw_need_finance" name="Approve" sourceRef="gw_manager" targetRef="gw_need_finance"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_need_finance_finance_approval" name="finance" sourceRef="gw_need_finance" targetRef="finance_approval"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">approval_level == 'finance'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_need_finance_gw_approved" name="no" sourceRef="gw_need_finance" targetRef="gw_approved"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_finance_end_rejected_finance" name="Reject" sourceRef="gw_finance" targetRef="end_rejected_finance"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == 'reject'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_finance_gw_approved" name="Approve" sourceRef="gw_finance" targetRef="gw_approved"></bpmn:sequenceFlow>
    <bpmn:textAnnotation id="note_policy"><bpmn:text>travel_policy: international or 5000+ -&gt; finance, 1000+ -&gt; manager, else auto</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_note_policy" sourceRef="decide_route" targetRef="note_policy" />
    <bpmn:group id="group_approvals" categoryValueRef="CategoryValue_group_approvals" />
  </bpmn:process>
