    <bpmn:endEvent id="EndEvent_unassigned" name="Approved"><bpmn:incoming>Flow_7</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Gateway_split"></bpmn:sequenceFlow>
