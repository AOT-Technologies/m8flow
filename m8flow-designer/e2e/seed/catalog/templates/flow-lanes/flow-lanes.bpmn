  <bpmn:process id="Process_flow_lanes" name="E2E Approval Lanes" isExecutable="true">
    <bpmn:documentation>An access request goes to three lanes at the same time: a tenant administrator approves it (Administrators), the designers sign it off (Designers: editors, who have no Task Review) and a lane that matches no group, so nobody is given that task. Each branch ends on its own.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_flow_lanes"><bpmn:lane id="Lane_administrators" name="Administrators"><bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_split</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_admin_approval</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_admin</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_designers" name="Designers"><bpmn:flowNodeRef>Activity_designers_signoff</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_designers</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_e2e nobody" name="E2E Nobody"><bpmn:flowNodeRef>Activity_unassigned</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_unassigned</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_1" name="Request raised"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:parallelGateway id="Gateway_split" name="To every lane"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing><bpmn:outgoing>Flow_3</bpmn:outgoing><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:parallelGateway>
    <bpmn:userTask id="Activity_admin_approval" name="E2E Admin Approval"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="e2e-flow-review-schema.json" /></spiffworkflow:properties></bpmn:extensionElements><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Activity_designers_signoff" name="E2E Design Sign-off"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="e2e-flow-review-schema.json" /></spiffworkflow:properties></bpmn:extensionElements><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Activity_unassigned" name="E2E Unassigned Approval"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="e2e-flow-review-schema.json" /></spiffworkflow:properties></bpmn:extensionElements><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask>
