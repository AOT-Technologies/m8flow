      <bpmndi:BPMNEdge id="Flow_notify_purchasing_end_purchasing_di" bpmnElement="Flow_notify_purchasing_end_purchasing"><di:waypoint x="1320" y="435" /><di:waypoint x="1417" y="435" /></bpmndi:BPMNEdge>
