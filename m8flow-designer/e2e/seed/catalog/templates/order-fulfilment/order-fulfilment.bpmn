<!-- Generated by e2e/seed/tools/build_catalog.py: edit the definition there, not this file. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core"
                  id="Definitions_e2e_order_fulfilment" targetNamespace="http://m8flow.org/e2e/catalog">
  <bpmn:collaboration id="Collaboration_e2e_order_fulfilment"><bpmn:participant id="Participant_e2e_order_fulfilment" name="E2E Order Fulfilment" processRef="e2e_order_fulfilment" /></bpmn:collaboration>
  <bpmn:escalation id="Escalation_backorder" name="Item on backorder" escalationCode="BACKORDER" />
  <bpmn:error id="Error_payment_failed" name="Payment failed" errorCode="PAYMENT_FAILED" />
  <bpmn:category id="Category_group_payment"><bpmn:categoryValue id="CategoryValue_group_payment" value="Payment" /></bpmn:category>
  <bpmn:process id="e2e_order_fulfilment" name="E2E Order Fulfilment" isExecutable="true">
    <bpmn:documentation>A sales order is picked item by item, paid, recorded in the database and shipped on the dispatch date. A payment failure releases the stock and stops the order. A back-ordered item escalates to purchasing without stopping the order.</bpmn:documentation>
    <bpmn:ioSpecification><bpmn:dataInput id="order_channel" name="Order channel" /><bpmn:dataOutput id="order_outcome" name="Order outcome" /><bpmn:inputSet><bpmn:dataInputRefs>order_channel</bpmn:dataInputRefs></bpmn:inputSet><bpmn:outputSet><bpmn:dataOutputRefs>order_outcome</bpmn:dataOutputRefs></bpmn:outputSet></bpmn:ioSpecification>
    <bpmn:laneSet id="LaneSet_e2e_order_fulfilment"><bpmn:lane id="Lane_submitters" name="Submitters"><bpmn:flowNodeRef>start_order</bpmn:flowNodeRef><bpmn:flowNodeRef>enter_order</bpmn:flowNodeRef><bpmn:flowNodeRef>pick</bpmn:flowNodeRef><bpmn:flowNodeRef>b_backorder</bpmn:flowNodeRef><bpmn:flowNodeRef>payment</bpmn:flowNodeRef><bpmn:flowNodeRef>b_cancelled</bpmn:flowNodeRef><bpmn:flowNodeRef>ensure_order_table</bpmn:flowNodeRef><bpmn:flowNodeRef>record_order</bpmn:flowNodeRef><bpmn:flowNodeRef>wait_dispatch</bpmn:flowNodeRef><bpmn:flowNodeRef>ship_order</bpmn:flowNodeRef><bpmn:flowNodeRef>end_shipped</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_administrators" name="Administrators"><bpmn:flowNodeRef>notify_purchasing</bpmn:flowNodeRef><bpmn:flowNodeRef>end_purchasing</bpmn:flowNodeRef><bpmn:flowNodeRef>release_stock</bpmn:flowNodeRef><bpmn:flowNodeRef>end_payment_failed</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="start_order" name="Order received"><bpmn:outgoing>Flow_start_order_enter_order</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="enter_order" name="Enter sales order"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="sales-order-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="sales-order-uischema.json" /></spiffworkflow:properties><spiffworkflow:preScript>order_channel = 'sales desk'</spiffworkflow:preScript><spiffworkflow:postScript>items = [i.strip() for i in item_list.split(',') if i.strip()]
picked = []
pick_index = 0
order_record = {'customer': customer, 'items': items}
order_outcome = 'open'</spiffworkflow:postScript></bpmn:extensionElements><bpmn:incoming>Flow_start_order_enter_order</bpmn:incoming><bpmn:outgoing>Flow_enter_order_pick</bpmn:outgoing><bpmn:dataOutputAssociation id="DataOut_enter_order"><bpmn:targetRef>order_ref</bpmn:targetRef></bpmn:dataOutputAssociation></bpmn:userTask>
    <bpmn:dataObjectReference id="order_ref" name="Sales order" dataObjectRef="order_record" />
    <bpmn:subProcess id="pick" name="Pick items"><bpmn:incoming>Flow_enter_order_pick</bpmn:incoming><bpmn:outgoing>Flow_pick_payment</bpmn:outgoing>
      <bpmn:startEvent id="pick_start"><bpmn:outgoing>Flow_pick_start_pick_items</bpmn:outgoing></bpmn:startEvent>
      <bpmn:scriptTask id="pick_items" name="Pick item" scriptFormat="python"><bpmn:incoming>Flow_pick_start_pick_items</bpmn:incoming><bpmn:outgoing>Flow_pick_items_gw_stock</bpmn:outgoing><bpmn:standardLoopCharacteristics loopMaximum="10"><bpmn:loopCondition xsi:type="bpmn:tFormalExpression">pick_index &lt; len(items)</bpmn:loopCondition></bpmn:standardLoopCharacteristics><bpmn:script>picked.append(items[pick_index])
pick_index += 1</bpmn:script></bpmn:scriptTask>
      <bpmn:exclusiveGateway id="gw_stock" name="All in stock?" default="Flow_gw_stock_pick_done"><bpmn:incoming>Flow_pick_items_gw_stock</bpmn:incoming><bpmn:outgoing>Flow_gw_stock_pick_backorder</bpmn:outgoing><bpmn:outgoing>Flow_gw_stock_pick_done</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="pick_done" name="Picked"><bpmn:incoming>Flow_gw_stock_pick_done</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="pick_backorder" name="Backorder"><bpmn:incoming>Flow_gw_stock_pick_backorder</bpmn:incoming><bpmn:escalationEventDefinition escalationRef="Escalation_backorder" /></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_pick_start_pick_items" sourceRef="pick_start" targetRef="pick_items"></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_pick_items_gw_stock" sourceRef="pick_items" targetRef="gw_stock"></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw_stock_pick_backorder" name="backorder" sourceRef="gw_stock" targetRef="pick_backorder"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">'backorder' in items</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw_stock_pick_done" name="in stock" sourceRef="gw_stock" targetRef="pick_done"></bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="b_backorder" name="Backorder" attachedToRef="pick" cancelActivity="false"><bpmn:outgoing>Flow_b_backorder_notify_purchasing</bpmn:outgoing><bpmn:escalationEventDefinition escalationRef="Escalation_backorder" /></bpmn:boundaryEvent>
    <bpmn:userTask id="notify_purchasing" name="Notify purchasing"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="purchasing-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="purchasing-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>Items on backorder for {{ customer }}: {{ items }}. Raise a purchase order.</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_b_backorder_notify_purchasing</bpmn:incoming><bpmn:outgoing>Flow_notify_purchasing_end_purchasing</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="end_purchasing" name="Purchasing notified"><bpmn:incoming>Flow_notify_purchasing_end_purchasing</bpmn:incoming></bpmn:endEvent>
    <bpmn:subProcess id="payment" name="Take payment"><bpmn:incoming>Flow_pick_payment</bpmn:incoming><bpmn:outgoing>Flow_payment_ensure_order_table</bpmn:outgoing>
      <bpmn:startEvent id="pay_start"><bpmn:outgoing>Flow_pay_start_reserve_stock</bpmn:outgoing></bpmn:startEvent>
      <bpmn:scriptTask id="reserve_stock" name="Reserve stock" scriptFormat="python"><bpmn:incoming>Flow_pay_start_reserve_stock</bpmn:incoming><bpmn:outgoing>Flow_reserve_stock_gw_paid</bpmn:outgoing><bpmn:script>reserved = True</bpmn:script></bpmn:scriptTask>
      <bpmn:exclusiveGateway id="gw_paid" name="Payment ok?" default="Flow_gw_paid_pay_end"><bpmn:incoming>Flow_reserve_stock_gw_paid</bpmn:incoming><bpmn:outgoing>Flow_gw_paid_pay_cancel</bpmn:outgoing><bpmn:outgoing>Flow_gw_paid_pay_end</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="pay_end" name="Paid"><bpmn:incoming>Flow_gw_paid_pay_end</bpmn:incoming></bpmn:endEvent>
      <bpmn:endEvent id="pay_cancel" name="Payment failed"><bpmn:incoming>Flow_gw_paid_pay_cancel</bpmn:incoming><bpmn:errorEventDefinition errorRef="Error_payment_failed" /></bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_pay_start_reserve_stock" sourceRef="pay_start" targetRef="reserve_stock"></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_reserve_stock_gw_paid" sourceRef="reserve_stock" targetRef="gw_paid"></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw_paid_pay_cancel" name="failed" sourceRef="gw_paid" targetRef="pay_cancel"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">payment_ok == False</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_gw_paid_pay_end" name="paid" sourceRef="gw_paid" targetRef="pay_end"></bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="b_cancelled" name="Payment failed" attachedToRef="payment"><bpmn:outgoing>Flow_b_cancelled_release_stock</bpmn:outgoing><bpmn:errorEventDefinition errorRef="Error_payment_failed" /></bpmn:boundaryEvent>
    <bpmn:scriptTask id="release_stock" name="Release stock" scriptFormat="python"><bpmn:incoming>Flow_b_cancelled_release_stock</bpmn:incoming><bpmn:outgoing>Flow_release_stock_end_payment_failed</bpmn:outgoing><bpmn:script>reserved = False
order_outcome = 'payment_failed'</bpmn:script></bpmn:scriptTask>
    <bpmn:endEvent id="end_payment_failed" name="Order cancelled"><bpmn:incoming>Flow_release_stock_end_payment_failed</bpmn:incoming></bpmn:endEvent>
    <bpmn:serviceTask id="ensure_order_table" name="Ensure order table"><bpmn:extensionElements><spiffworkflow:serviceTaskOperator id="postgres_v2/DoSQL" resultVariable="order_table"><spiffworkflow:parameters><spiffworkflow:parameter id="m8flow_profile" type="any" value='"e2e"' /><spiffworkflow:parameter id="database_connection_str" type="any" /><spiffworkflow:parameter id="schema" type="any" value="{'sql': 'CREATE TABLE IF NOT EXISTS e2e_order_ledger (id serial PRIMARY KEY, customer text, item_count integer, created_at timestamptz DEFAULT now())'}" /></spiffworkflow:parameters></spiffworkflow:serviceTaskOperator></bpmn:extensionElements><bpmn:incoming>Flow_payment_ensure_order_table</bpmn:incoming><bpmn:outgoing>Flow_ensure_order_table_record_order</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="record_order" name="Record order"><bpmn:extensionElements><spiffworkflow:serviceTaskOperator id="postgres_v2/DoSQL" resultVariable="order_row"><spiffworkflow:parameters><spiffworkflow:parameter id="m8flow_profile" type="any" value='"e2e"' /><spiffworkflow:parameter id="database_connection_str" type="any" /><spiffworkflow:parameter id="schema" type="any" value="{'sql': 'INSERT INTO e2e_order_ledger (customer, item_count) VALUES (%s, %s) RETURNING id', 'values': [customer, len(items)], 'fetch_results': True}" /></spiffworkflow:parameters></spiffworkflow:serviceTaskOperator><spiffworkflow:postScript>order_id = order_row['command_response']['body']['body'][0][0]</spiffworkflow:postScript></bpmn:extensionElements><bpmn:incoming>Flow_ensure_order_table_record_order</bpmn:incoming><bpmn:outgoing>Flow_record_order_wait_dispatch</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="wait_dispatch" name="Wait for dispatch date"><bpmn:incoming>Flow_record_order_wait_dispatch</bpmn:incoming><bpmn:outgoing>Flow_wait_dispatch_ship_order</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDate xsi:type="bpmn:tFormalExpression">dispatch_on</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="ship_order" name="Ship order"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="shipment-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="shipment-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>Ship order {{ order_id }} for {{ order_record['customer'] }}: {{ picked }}.</spiffworkflow:instructionsForEndUser><spiffworkflow:postScript>order_outcome = 'shipped'</spiffworkflow:postScript></bpmn:extensionElements><bpmn:incoming>Flow_wait_dispatch_ship_order</bpmn:incoming><bpmn:outgoing>Flow_ship_order_end_shipped</bpmn:outgoing><bpmn:dataInputAssociation id="DataIn_ship_order"><bpmn:sourceRef>order_ref_ship</bpmn:sourceRef></bpmn:dataInputAssociation></bpmn:userTask>
    <bpmn:dataObjectReference id="order_ref_ship" name="Sales order" dataObjectRef="order_record" />
    <bpmn:endEvent id="end_shipped" name="Order shipped"><bpmn:incoming>Flow_ship_order_end_shipped</bpmn:incoming></bpmn:endEvent>
    <bpmn:dataObject id="order_record" />
    <bpmn:sequenceFlow id="Flow_start_order_enter_order" sourceRef="start_order" targetRef="enter_order"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_enter_order_pick" sourceRef="enter_order" targetRef="pick"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_b_backorder_notify_purchasing" sourceRef="b_backorder" targetRef="notify_purchasing"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_notify_purchasing_end_purchasing" sourceRef="notify_purchasing" targetRef="end_purchasing"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_pick_payment" sourceRef="pick" targetRef="payment"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_b_cancelled_release_stock" sourceRef="b_cancelled" targetRef="release_stock"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_release_stock_end_payment_failed" sourceRef="release_stock" targetRef="end_payment_failed"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_payment_ensure_order_table" sourceRef="payment" targetRef="ensure_order_table"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ensure_order_table_record_order" sourceRef="ensure_order_table" targetRef="record_order"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_record_order_wait_dispatch" sourceRef="record_order" targetRef="wait_dispatch"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_wait_dispatch_ship_order" sourceRef="wait_dispatch" targetRef="ship_order"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ship_order_end_shipped" sourceRef="ship_order" targetRef="end_shipped"></bpmn:sequenceFlow>
    <bpmn:textAnnotation id="note_dispatch"><bpmn:text>Waits until the dispatch date entered on the order (today = ships at once)</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_note_dispatch" sourceRef="wait_dispatch" targetRef="note_dispatch" />
    <bpmn:group id="group_payment" categoryValueRef="CategoryValue_group_payment" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_e2e_order_fulfilment">
