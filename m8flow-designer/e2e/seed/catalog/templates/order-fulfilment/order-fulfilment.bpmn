      <bpmndi:BPMNEdge id="Flow_pay_start_reserve_stock_di" bpmnElement="Flow_pay_start_reserve_stock"><di:waypoint x="1453" y="135" /><di:waypoint x="1550" y="135" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_reserve_stock_gw_paid_di" bpmnElement="Flow_reserve_stock_gw_paid"><di:waypoint x="1650" y="135" /><di:waypoint x="1740" y="135" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_b_cancelled_release_stock_di" bpmnElement="Flow_b_cancelled_release_stock"><di:waypoint x="1682.5" y="218" /><di:waypoint x="1682.5" y="585" /><di:waypoint x="1715" y="585" /></bpmndi:BPMNEdge>
