  <bpmn:collaboration id="Collaboration_e2e_work_from_home"><bpmn:participant id="Participant_e2e_work_from_home" name="E2E Work From Home Request" processRef="e2e_work_from_home" /></bpmn:collaboration>
  
  <bpmn:process id="e2e_work_from_home" name="E2E Work From Home Request" isExecutable="true">
    <bpmn:documentation>An employee asks to work from home for some days; the manager approves or rejects it.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_e2e_work_from_home"><bpmn:lane id="Lane_submitters" name="Submitters"><bpmn:flowNodeRef>start_wfh</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_submit_wfh</bpmn:flowNodeRef><bpmn:flowNodeRef>record_wfh</bpmn:flowNodeRef><bpmn:flowNodeRef>end_wfh_approved</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_approvers" name="Approvers"><bpmn:flowNodeRef>Activity_review_wfh</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_wfh_decision</bpmn:flowNodeRef><bpmn:flowNodeRef>end_wfh_rejected</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="start_wfh" name="WFH needed"><bpmn:outgoing>Flow_start_wfh_Activity_submit_wfh</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Activity_submit_wfh" name="Submit WFH Request"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="wfh-form-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="wfh-form-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>Enter the days you want to work from home and why.</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_start_wfh_Activity_submit_wfh</bpmn:incoming><bpmn:outgoing>Flow_Activity_submit_wfh_Activity_review_wfh</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Activity_review_wfh" name="Review WFH Request"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="wfh-review-form-schema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>Work from home from {{ start_date }} to {{ end_date }}: {{ reason }}</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_Activity_submit_wfh_Activity_review_wfh</bpmn:incoming><bpmn:outgoing>Flow_Activity_review_wfh_gw_wfh_decision</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_wfh_decision" name="Approved?" default="Flow_gw_wfh_decision_end_wfh_rejected"><bpmn:incoming>Flow_Activity_review_wfh_gw_wfh_decision</bpmn:incoming><bpmn:outgoing>Flow_gw_wfh_decision_record_wfh</bpmn:outgoing><bpmn:outgoing>Flow_gw_wfh_decision_end_wfh_rejected</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="record_wfh" name="Record WFH days" scriptFormat="python"><bpmn:incoming>Flow_gw_wfh_decision_record_wfh</bpmn:incoming><bpmn:outgoing>Flow_record_wfh_end_wfh_approved</bpmn:outgoing><bpmn:script>wfh_status = 'approved'</bpmn:script></bpmn:scriptTask>
    <bpmn:endEvent id="end_wfh_approved" name="WFH approved"><bpmn:incoming>Flow_record_wfh_end_wfh_approved</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="end_wfh_rejected" name="WFH rejected"><bpmn:incoming>Flow_gw_wfh_decision_end_wfh_rejected</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_wfh_Activity_submit_wfh" sourceRef="start_wfh" targetRef="Activity_submit_wfh"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Activity_submit_wfh_Activity_review_wfh" sourceRef="Activity_submit_wfh" targetRef="Activity_review_wfh"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Activity_review_wfh_gw_wfh_decision" sourceRef="Activity_review_wfh" targetRef="gw_wfh_decision"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_record_wfh_end_wfh_approved" sourceRef="record_wfh" targetRef="end_wfh_approved"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_wfh_decision_record_wfh" name="approve" sourceRef="gw_wfh_decision" targetRef="record_wfh"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">decision == 'Approve'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_wfh_decision_end_wfh_rejected" name="reject" sourceRef="gw_wfh_decision" targetRef="end_wfh_rejected"></bpmn:sequenceFlow>
  </bpmn:process>
