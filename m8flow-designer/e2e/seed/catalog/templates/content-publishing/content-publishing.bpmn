<?xml version="1.0" encoding="UTF-8"?>
<!-- Generated by e2e/seed/tools/build_catalog.py: edit the definition there, not this file. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:spiffworkflow="http://spiffworkflow.org/bpmn/schema/1.0/core"
                  id="Definitions_e2e_content_publishing" targetNamespace="http://m8flow.org/e2e/catalog">
  <bpmn:collaboration id="Collaboration_e2e_content_publishing"><bpmn:participant id="Participant_e2e_content_publishing" name="E2E Content Publishing" processRef="e2e_content_publishing" /><bpmn:participant id="Participant_subscribers" name="Subscribers" /><bpmn:messageFlow id="MessageFlow_new_article" name="New article" sourceRef="notify_subscribers" targetRef="Participant_subscribers" messageRef="Message_new_article" /></bpmn:collaboration>
  <bpmn:message id="Message_new_article" name="new_article" />
  <bpmn:process id="e2e_content_publishing" name="E2E Content Publishing" isExecutable="true">
    <bpmn:documentation>An author drafts an article; the words are counted and the editor reviews it, and sends it back until it is ready. The publisher schedules it; at that time it goes to the chosen channels and subscribers are notified.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_e2e_content_publishing"><bpmn:lane id="Lane_submitters" name="Submitters"><bpmn:flowNodeRef>start_article</bpmn:flowNodeRef><bpmn:flowNodeRef>draft_article</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_review_entry</bpmn:flowNodeRef><bpmn:flowNodeRef>count_words</bpmn:flowNodeRef><bpmn:flowNodeRef>revise_article</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_channels</bpmn:flowNodeRef><bpmn:flowNodeRef>post_website</bpmn:flowNodeRef><bpmn:flowNodeRef>prepare_newsletter</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_channels_join</bpmn:flowNodeRef><bpmn:flowNodeRef>cool_down</bpmn:flowNodeRef><bpmn:flowNodeRef>notify_subscribers</bpmn:flowNodeRef><bpmn:flowNodeRef>end_published</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_approvers" name="Approvers"><bpmn:flowNodeRef>editorial_review</bpmn:flowNodeRef><bpmn:flowNodeRef>gw_changes</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_administrators" name="Administrators"><bpmn:flowNodeRef>schedule_article</bpmn:flowNodeRef><bpmn:flowNodeRef>wait_publish</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="start_article" name="Article idea"><bpmn:outgoing>Flow_start_article_draft_article</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="draft_article" name="Draft article"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="article-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="article-uischema.json" /></spiffworkflow:properties></bpmn:extensionElements><bpmn:incoming>Flow_start_article_draft_article</bpmn:incoming><bpmn:outgoing>Flow_draft_article_gw_review_entry</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_review_entry"><bpmn:incoming>Flow_draft_article_gw_review_entry</bpmn:incoming><bpmn:incoming>Flow_revise_article_gw_review_entry</bpmn:incoming><bpmn:outgoing>Flow_gw_review_entry_count_words</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:scriptTask id="count_words" name="Count words" scriptFormat="python"><bpmn:incoming>Flow_gw_review_entry_count_words</bpmn:incoming><bpmn:outgoing>Flow_count_words_editorial_review</bpmn:outgoing><bpmn:script>word_count = len(body.split())</bpmn:script></bpmn:scriptTask>
    <bpmn:userTask id="editorial_review" name="Editorial review"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="editorial-review-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="editorial-review-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>{{ headline }} ({{ word_count }} words): {{ body }}</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_count_words_editorial_review</bpmn:incoming><bpmn:outgoing>Flow_editorial_review_gw_changes</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="gw_changes" name="Changes requested?" default="Flow_gw_changes_schedule_article"><bpmn:incoming>Flow_editorial_review_gw_changes</bpmn:incoming><bpmn:outgoing>Flow_gw_changes_revise_article</bpmn:outgoing><bpmn:outgoing>Flow_gw_changes_schedule_article</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="revise_article" name="Revise article"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="revision-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="revision-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>Editor's notes: {{ notes }}</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_gw_changes_revise_article</bpmn:incoming><bpmn:outgoing>Flow_revise_article_gw_review_entry</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="schedule_article" name="Schedule publication"><bpmn:extensionElements><spiffworkflow:properties><spiffworkflow:property name="formJsonSchemaFilename" value="schedule-schema.json" /><spiffworkflow:property name="formUiSchemaFilename" value="schedule-uischema.json" /></spiffworkflow:properties><spiffworkflow:instructionsForEndUser>{{ headline }} ({{ word_count }} words) is approved. Pick the publication date (today = publish now).</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_gw_changes_schedule_article</bpmn:incoming><bpmn:outgoing>Flow_schedule_article_wait_publish</bpmn:outgoing></bpmn:userTask>
    <bpmn:intermediateCatchEvent id="wait_publish" name="Publication time"><bpmn:incoming>Flow_schedule_article_wait_publish</bpmn:incoming><bpmn:outgoing>Flow_wait_publish_gw_channels</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDate xsi:type="bpmn:tFormalExpression">publish_on</bpmn:timeDate></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:inclusiveGateway id="gw_channels" name="Channels" default="Flow_gw_channels_gw_channels_join"><bpmn:incoming>Flow_wait_publish_gw_channels</bpmn:incoming><bpmn:outgoing>Flow_gw_channels_post_website</bpmn:outgoing><bpmn:outgoing>Flow_gw_channels_prepare_newsletter</bpmn:outgoing><bpmn:outgoing>Flow_gw_channels_gw_channels_join</bpmn:outgoing></bpmn:inclusiveGateway>
    <bpmn:scriptTask id="post_website" name="Post to website" scriptFormat="python"><bpmn:incoming>Flow_gw_channels_post_website</bpmn:incoming><bpmn:outgoing>Flow_post_website_gw_channels_join</bpmn:outgoing><bpmn:script>published_url = '/news/' + headline.lower().replace(' ', '-')</bpmn:script></bpmn:scriptTask>
    <bpmn:manualTask id="prepare_newsletter" name="Prepare newsletter"><bpmn:extensionElements><spiffworkflow:instructionsForEndUser>Add {{ headline }} to the next newsletter, then click Submit.</spiffworkflow:instructionsForEndUser></bpmn:extensionElements><bpmn:incoming>Flow_gw_channels_prepare_newsletter</bpmn:incoming><bpmn:outgoing>Flow_prepare_newsletter_gw_channels_join</bpmn:outgoing></bpmn:manualTask>
    <bpmn:inclusiveGateway id="gw_channels_join"><bpmn:incoming>Flow_post_website_gw_channels_join</bpmn:incoming><bpmn:incoming>Flow_prepare_newsletter_gw_channels_join</bpmn:incoming><bpmn:incoming>Flow_gw_channels_gw_channels_join</bpmn:incoming><bpmn:outgoing>Flow_gw_channels_join_cool_down</bpmn:outgoing></bpmn:inclusiveGateway>
    <bpmn:intermediateCatchEvent id="cool_down" name="Wait 5 s"><bpmn:incoming>Flow_gw_channels_join_cool_down</bpmn:incoming><bpmn:outgoing>Flow_cool_down_notify_subscribers</bpmn:outgoing><bpmn:timerEventDefinition><bpmn:timeDuration xsi:type="bpmn:tFormalExpression">"PT5S"</bpmn:timeDuration></bpmn:timerEventDefinition></bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="notify_subscribers" name="Notify subscribers" messageRef="Message_new_article"><bpmn:incoming>Flow_cool_down_notify_subscribers</bpmn:incoming><bpmn:outgoing>Flow_notify_subscribers_end_published</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="end_published" name="Article published"><bpmn:incoming>Flow_notify_subscribers_end_published</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_article_draft_article" sourceRef="start_article" targetRef="draft_article"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_draft_article_gw_review_entry" sourceRef="draft_article" targetRef="gw_review_entry"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_review_entry_count_words" sourceRef="gw_review_entry" targetRef="count_words"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_count_words_editorial_review" sourceRef="count_words" targetRef="editorial_review"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_editorial_review_gw_changes" sourceRef="editorial_review" targetRef="gw_changes"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_revise_article_gw_review_entry" sourceRef="revise_article" targetRef="gw_review_entry"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_schedule_article_wait_publish" sourceRef="schedule_article" targetRef="wait_publish"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_wait_publish_gw_channels" sourceRef="wait_publish" targetRef="gw_channels"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_post_website_gw_channels_join" sourceRef="post_website" targetRef="gw_channels_join"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_prepare_newsletter_gw_channels_join" sourceRef="prepare_newsletter" targetRef="gw_channels_join"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_channels_join_cool_down" sourceRef="gw_channels_join" targetRef="cool_down"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_cool_down_notify_subscribers" sourceRef="cool_down" targetRef="notify_subscribers"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_notify_subscribers_end_published" sourceRef="notify_subscribers" targetRef="end_published"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_changes_revise_article" name="Send back for changes" sourceRef="gw_changes" targetRef="revise_article"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == 'changes'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_changes_schedule_article" name="Publish" sourceRef="gw_changes" targetRef="schedule_article"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_channels_post_website" name="website" sourceRef="gw_channels" targetRef="post_website"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">website == True</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_channels_prepare_newsletter" name="newsletter" sourceRef="gw_channels" targetRef="prepare_newsletter"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">newsletter == True</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_gw_channels_gw_channels_join" name="no channel" sourceRef="gw_channels" targetRef="gw_channels_join"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_e2e_content_publishing">
    <bpmndi:BPMNPlane id="BPMNPlane_e2e_content_publishing" bpmnElement="Collaboration_e2e_content_publishing">
