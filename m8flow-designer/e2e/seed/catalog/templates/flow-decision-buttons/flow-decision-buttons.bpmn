    <bpmn:exclusiveGateway id="Gateway_decision" name="Decision"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_reject</bpmn:outgoing><bpmn:outgoing>Flow_approve</bpmn:outgoing></bpmn:exclusiveGateway>
