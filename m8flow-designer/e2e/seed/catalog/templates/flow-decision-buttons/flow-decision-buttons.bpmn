    <bpmn:documentation>An approver accepts or rejects a supplier quote with the Approve / Reject buttons.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_Process_flow_decision_buttons"><bpmn:lane id="Lane_approvers" name="Approvers"><bpmn:flowNodeRef>StartEvent_1</bpmn:flowNodeRef><bpmn:flowNodeRef>Activity_approve_request</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_decision</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_1</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_other</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
