    <bpmn:sequenceFlow id="Flow_reject" name="Reject" sourceRef="Gateway_decision" targetRef="EndEvent_other"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == 'reject'</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_approve" name="Approve" sourceRef="Gateway_decision" targetRef="EndEvent_1"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">outcome == 'approve'</bpmn:conditionExpression></bpmn:sequenceFlow>
